+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/ez80/ez80f91.h"
+#include "system/address-spaces.h"
+#include "net/net.h"
+
+#define TYPE_F91_EMAC "ez80f91-emac"
+OBJECT_DECLARE_SIMPLE_TYPE(F91EmacState, F91_EMAC)
+struct F91EmacState {
+    SysBusDevice parent_obj;
+    MemoryRegion ports;
+    DeviceState *memory;
+    NICConf conf;
+    NICState *nic;
+    Clock *sclk;
+    QEMUTimer *poll;
+    qemu_irq irq[3];
+    uint8_t r[0x5a];
+    uint8_t phy_addr;
+    uint16_t phy[32], trp, rwp;
+    bool tx_fault;
+};
+static unsigned ptr(F91EmacState *s, unsigned reg)
+{
+    return (s->r[reg] | (s->r[reg + 1] << 8)) & 0x1fe0;
+}
+static void irq_update(F91EmacState *s)
+{
+    unsigned pending = s->r[0x4c] & s->r[0x4d];
+    qemu_set_irq(s->irq[0], !!(pending & 0x38));
+    qemu_set_irq(s->irq[1], !!(pending & 3));
+    qemu_set_irq(s->irq[2], !!(pending & 0xc4));
+}
+static void status(F91EmacState *s, unsigned bits)
+{
+    s->r[0x4d] |= bits;
+    irq_update(s);
+}
+static bool link_up(F91EmacState *s)
+{
+    return !(s->phy[0] & 0x0c00) &&
+        ((s->phy[0] & 0x4000) || (s->r[0x20] & 1) ||
+         (qemu_get_queue(s->nic)->peer && !qemu_get_queue(s->nic)->link_down));
+}
+static unsigned rx_end(F91EmacState *s)
+{
+    unsigned end = ptr(s, 0x47);
+    return end ? end : 8192;
+}
+static unsigned block_size(F91EmacState *s)
+{
+    return 256 >> (s->r[0x4b] >> 6);
+}
+static unsigned free_blocks(F91EmacState *s)
+{
+    unsigned start = ptr(s, 0x44), end = rx_end(s);
+    unsigned rr = ptr(s, 0x49), block = block_size(s), available;
+    if (end <= start || s->rwp < start || s->rwp >= end ||
+        rr < start || rr >= end) {
+        return 0;
+    }
+    available = rr > s->rwp ? rr - s->rwp : end - s->rwp + rr - start;
+    return available >= block ? available / block - 1 : 0;
+}
+/* Wrap payloads inside their own ring, never into another DMA region. */
+static void ring_copy(uint8_t *ram, unsigned start, unsigned end,
+                      unsigned pos, uint8_t *buf, unsigned len, bool write)
+{
+    for (unsigned i = 0; i < len; i++) {
+        unsigned at = start + (pos - start + i) % (end - start);
+        if (write) {
+            ram[at] = buf[i];
+        } else {
+            buf[i] = ram[at];
+        }
+    }
+}
+static ssize_t receive(NetClientState *nc, const uint8_t *buf, size_t len)
+{
+    F91EmacState *s = qemu_get_nic_opaque(nc);
+    unsigned start = ptr(s, 0x44), end = rx_end(s), block = block_size(s);
+    unsigned needed, next, flags = 0x8000;
+    uint8_t desc[7], fcs[4], *ram;
+    bool broadcast, multicast;
+    if (!ez80f91_emac_enabled(s->memory) || (s->r[0x41] & 0x2a) ||
+        !(s->r[0x24] & 1) || !link_up(s) || (s->r[0x4d] & 4) ||
+        len < 14 || len > 8192 - 11 || start >= end) {
+        return len;
+    }
+    broadcast = !memcmp(buf, "\xff\xff\xff\xff\xff\xff", 6);
+    multicast = buf[0] & 1;
+    if (!(s->r[0x32] & 8) && memcmp(buf, s->r + 0x25, 6)) {
+        unsigned hash = net_crc32(buf, 6) >> 26;
+        bool match = broadcast ? s->r[0x32] & 1 : multicast &&
+            ((s->r[0x32] & 4) || ((s->r[0x32] & 2) &&
+             (s->r[0x33 + hash / 8] & (1 << (hash % 8)))));
+        if (!match) {
+            return len;
+        }
+    }
+    if (len + 4 > lduw_le_p(s->r + 0x30) && !(s->r[0x21] & 2)) {
+        return len;
+    }
+    needed = DIV_ROUND_UP(len + 11, block);
+    if (needed > free_blocks(s)) {
+        /* Keep the final reserved block for an overrun descriptor. Zilog's
+         * driver need not enable the separate overrun interrupt: it discovers
+         * RxOVR in this final RXDONE packet and clears the receiver latch.
+         * A status bit without a descriptor leaves that driver stuck forever.
+         */
+        if (s->rwp < start || s->rwp >= end || end - start < block ||
+            ptr(s, 0x49) < start || ptr(s, 0x49) >= end) {
+            return len;
+        }
+        next = start + (s->rwp - start + block) % (end - start);
+        st24_le_p(desc, ez80f91_emac_base(s->memory) + next);
+        stw_le_p(desc + 3, 0);
+        stw_le_p(desc + 5, 1); /* RxOVR; the incomplete packet is not RxOK. */
+        ram = memory_region_get_ram_ptr(ez80f91_emac_ram(s->memory));
+        ring_copy(ram, start, end, s->rwp, desc, sizeof(desc), true);
+        memory_region_set_dirty(ez80f91_emac_ram(s->memory), start, end - start);
+        s->rwp = next;
+        status(s, 0xc);
+        return len;
+    }
+    next = start + (s->rwp - start + needed * block) % (end - start);
+    if (broadcast) {
+        flags |= 0x100;
+    } else if (multicast) {
+        flags |= 0x200;
+    }
+    if (buf[12] == 0x81 && buf[13] == 0) {
+        flags |= 0x80;
+    }
+    st24_le_p(desc, ez80f91_emac_base(s->memory) + next);
+    stw_le_p(desc + 3, len + 4);
+    stw_le_p(desc + 5, flags);
+    stl_le_p(fcs, crc32(0, buf, len));
+    ram = memory_region_get_ram_ptr(ez80f91_emac_ram(s->memory));
+    ring_copy(ram, start, end, s->rwp + 7, (uint8_t *)buf, len, true);
+    ring_copy(ram, start, end, s->rwp + 7 + len, fcs, 4, true);
+    ring_copy(ram, start, end, s->rwp, desc, 7, true);
+    memory_region_set_dirty(ez80f91_emac_ram(s->memory), start, end - start);
+    s->rwp = next;
+    status(s, 8);
+    return len;
+}
+static void transmit(F91EmacState *s)
+{
+    unsigned start = ptr(s, 0x42), end = ptr(s, 0x44);
+    uint8_t *ram = memory_region_get_ram_ptr(ez80f91_emac_ram(s->memory));
+    if (!ez80f91_emac_enabled(s->memory) || (s->r[0x41] & 0x34) ||
+        !link_up(s) || s->tx_fault || start >= end) {
+        return;
+    }
+    for (unsigned count = 0; count < 256; count++) {
+        uint8_t desc[7], packet[8192];
+        unsigned next, len, result = 0, sendlen;
+        if (s->trp < start || s->trp + 7 > end) {
+            s->tx_fault = true;
+            status(s, 0x80);
+            break;
+        }
+        memcpy(desc, ram + s->trp, 7);
+        if (!(lduw_le_p(desc + 5) & 0x8000)) {
+            break;
+        }
+        next = lduw_le_p(desc) | (desc[2] << 16);
+        len = lduw_le_p(desc + 3);
+        if (next < ez80f91_emac_base(s->memory) + start ||
+            next >= ez80f91_emac_base(s->memory) + end ||
+            (next & (block_size(s) - 1)) || len < 14 || len > end - start - 7) {
+            stw_le_p(ram + s->trp + 5, 0x4000);
+            s->tx_fault = true;
+            status(s, 0x81);
+            break;
+        }
+        next -= ez80f91_emac_base(s->memory);
+        ring_copy(ram, start, end, s->trp + 7, packet, len, false);
+        sendlen = len;
+        if (!(s->r[0x21] & 0x10)) {
+            if (len < 18 || ldl_le_p(packet + len - 4) !=
+                crc32(0, packet, len - 4)) {
+                result = 0x4200;
+            } else {
+                sendlen -= 4;
+            }
+        }
+        if ((s->r[0x21] & 0x90) == 0x90 && sendlen < 60) {
+            memset(packet + sendlen, 0, 60 - sendlen);
+            sendlen = 60;
+        }
+        if (sendlen + 4 > lduw_le_p(s->r + 0x30)) {
+            result |= 0x5000;
+        }
+        stw_le_p(ram + s->trp + 5, result);
+        s->trp = next;
+        if (!result) {
+            if ((s->r[0x20] & 1) || (s->phy[0] & 0x4000)) {
+                receive(qemu_get_queue(s->nic), packet, sendlen);
+            } else {
+                qemu_send_packet(qemu_get_queue(s->nic), packet, sendlen);
+            }
+        }
+        status(s, 1);
+    }
+    memory_region_set_dirty(ez80f91_emac_ram(s->memory), start, end - start);
+}
+static void schedule(F91EmacState *s)
+{
+    uint64_t hz = clock_get_hz(s->sclk);
+    timer_del(s->poll);
+    if (s->r[0x40] && hz && !(s->r[0x41] & 0x34)) {
+        timer_mod(s->poll, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  DIV_ROUND_UP(256000000000ull * s->r[0x40], hz));
+    }
+}
+static void poll_tx(void *opaque)
+{
+    F91EmacState *s = opaque;
+    transmit(s);
+    schedule(s);
+}
+static void phy_reset(F91EmacState *s)
+{
+    memset(s->phy, 0, sizeof(s->phy));
+    s->phy[0] = 0x3100;
+    s->phy[2] = 0x22;
+    s->phy[3] = 0x561b;
+    s->phy[4] = s->phy[5] = 0x1e1;
+    s->phy[6] = 1;
+}
+static void mii(F91EmacState *s, uint8_t value)
+{
+    unsigned reg = s->r[0x3e];
+    uint16_t data = 0xffff;
+    if (s->r[0x41] & 0x21) {
+        return;
+    }
+    if (s->r[0x3f] == s->phy_addr) {
+        if (value & 0x80) {
+            if (reg != 1 && reg != 2 && reg != 3 && reg != 5 && reg != 6) {
+                s->phy[reg] = lduw_le_p(s->r + 0x3c);
+                if (reg == 0) {
+                    if (s->phy[0] & 0x8000) {
+                        phy_reset(s);
+                    }
+                    s->phy[0] &= ~0x200;
+                }
+            }
+        }
+        data = reg == 1 ? 0x7849 | (link_up(s) ? 0x24 : 0) : s->phy[reg];
+    }
+    if (value & 0x50) {
+        stw_le_p(s->r + 0x4e, data);
+    }
+    if (value & 0xd0) {
+        status(s, 0x40);
+    }
+    s->r[0x3b] = value & 0x3f;
+}
+static uint64_t emac_read(void *opaque, hwaddr offset, unsigned size)
+{
+    F91EmacState *s = opaque;
+    unsigned reg = offset + 0x20;
+    switch (reg) {
+    case 0x45:
+        return s->r[reg] | 0xc0;
+    case 0x46:
+        return ez80f91_emac_base(s->memory) >> 16;
+    case 0x4e:
+    case 0x4f:
+        if (s->r[0x3b] & 0x10) {
+            mii(s, s->r[0x3b]);
+        }
+        return s->r[reg];
+    case 0x50:
+        return s->r[0x3f] | (link_up(s) ? 0 : 0x40);
+    case 0x51:
+        return s->rwp & 0xff;
+    case 0x52:
+        return s->rwp >> 8;
+    case 0x53:
+        return s->trp & 0xff;
+    case 0x54:
+        return s->trp >> 8;
+    case 0x55:
+        return free_blocks(s) & 0xff;
+    case 0x56:
+        return free_blocks(s) >> 8;
+    case 0x59:
+        return 0x33;
+    default:
+        return s->r[reg];
+    }
+}
+static void emac_write(void *opaque, hwaddr offset, uint64_t value,
+                        unsigned size)
+{
+    F91EmacState *s = opaque;
+    unsigned reg = offset + 0x20;
+    if (reg == 0x46 || reg >= 0x4e) {
+        return;
+    }
+    if (reg == 0x4d) {
+        s->r[reg] &= ~value;
+        irq_update(s);
+        return;
+    }
+    if (reg == 0x3e || reg == 0x3f || reg == 0x43 || reg == 0x45 ||
+        reg == 0x48 || reg == 0x4a) {
+        value &= 0x1f;
+    }
+    if (reg == 0x42 || reg == 0x44 || reg == 0x47 || reg == 0x49) {
+        value &= 0xe0;
+    }
+    if (reg == 0x41) {
+        value &= 0x3f;
+    }
+    if (reg == 0x32) {
+        value &= 15;
+    }
+    if (reg == 0x3b) {
+        mii(s, value);
+        return;
+    }
+    s->r[reg] = value;
+    if (reg == 0x41) {
+        if (value & 0x34) {
+            s->trp = ptr(s, 0x42);
+            s->tx_fault = false;
+            s->r[0x4d] &= ~0x83;
+        }
+        if (value & 0x2a) {
+            s->rwp = ptr(s, 0x44);
+            s->r[0x4d] &= ~0x3c;
+        }
+        if (value & 0x21) {
+            s->r[0x3b] = 0;
+            stw_le_p(s->r + 0x4e, 0);
+            s->r[0x4d] &= ~0x40;
+        }
+        if (value & 0x20) {
+            s->r[0x4d] = 0;
+        }
+        irq_update(s);
+        schedule(s);
+    }
+    if ((reg == 0x42 || reg == 0x43) && (s->r[0x41] & 0x34)) {
+        s->trp = ptr(s, 0x42);
+    }
+    if ((reg == 0x44 || reg == 0x45) && (s->r[0x41] & 0x2a)) {
+        s->rwp = ptr(s, 0x44);
+    }
+    if (reg == 0x40) {
+        transmit(s);
+        schedule(s);
+    }
+    if (reg == 0x4c) {
+        irq_update(s);
+    }
+}
+static const MemoryRegionOps emac_ops = {
+    .read = emac_read, .write = emac_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static NetClientInfo net_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .receive = receive,
+};
+static void emac_reset(Object *obj, ResetType type)
+{
+    F91EmacState *s = F91_EMAC(obj);
+    timer_del(s->poll);
+    memset(s->r, 0, sizeof(s->r));
+    s->r[0x22] = 0x37;
+    s->r[0x23] = 0xf;
+    s->r[0x2d] = 0x15;
+    s->r[0x2e] = 0xc;
+    s->r[0x2f] = 0x12;
+    s->r[0x31] = 6;
+    s->r[0x41] = 0x20;
+    s->trp = s->rwp = 0;
+    s->tx_fault = false;
+    phy_reset(s);
+    irq_update(s);
+}
+static void emac_realize(DeviceState *dev, Error **errp)
+{
+    F91EmacState *s = F91_EMAC(dev);
+    if (!s->memory || s->phy_addr > 31) {
+        error_setg(errp, "F91 EMAC requires memory and PHY address 0..31");
+        return;
+    }
+    qemu_macaddr_default_if_unset(&s->conf.macaddr);
+    s->nic = qemu_new_nic(&net_info, &s->conf, TYPE_F91_EMAC, dev->id,
+                          &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+}
+static void emac_unrealize(DeviceState *dev)
+{
+    F91EmacState *s = F91_EMAC(dev);
+    timer_del(s->poll);
+    qemu_del_nic(s->nic);
+}
+static void emac_init(Object *obj)
+{
+    F91EmacState *s = F91_EMAC(obj);
+    s->sclk = qdev_init_clock_in(DEVICE(s), "sclk", NULL, NULL, 0);
+    s->poll = timer_new_ns(QEMU_CLOCK_VIRTUAL, poll_tx, s);
+    for (unsigned i = 0; i < 3; i++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq[i]);
+    }
+    memory_region_init_io(&s->ports, obj, &emac_ops, s, "f91.emac", 0x3a);
+    memory_region_add_subregion(get_system_io(), 0x20, &s->ports);
+}
+static void emac_finalize(Object *obj)
+{
+    timer_free(F91_EMAC(obj)->poll);
+}
+static const Property emac_properties[] = {
+    DEFINE_NIC_PROPERTIES(F91EmacState, conf),
+    DEFINE_PROP_LINK("memory", F91EmacState, memory,
+                     "ez80f91-memory", DeviceState *),
+    DEFINE_PROP_UINT8("phy-addr", F91EmacState, phy_addr, 0),
+};
+static void emac_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = emac_realize;
+    dc->unrealize = emac_unrealize;
+    dc->user_creatable = false;
+    device_class_set_props(dc, emac_properties);
+    RESETTABLE_CLASS(oc)->phases.hold = emac_reset;
+}
+static const TypeInfo emac_type = {
+    .name = TYPE_F91_EMAC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(F91EmacState),
+    .instance_init = emac_init,
+    .instance_finalize = emac_finalize,
+    .class_init = emac_class_init,
+};
+static void emac_register_types(void)
+{
+    type_register_static(&emac_type);
+}
+type_init(emac_register_types);
diff --git a/hw/ez80/ez80f91.c b/hw/ez80/ez80f91.c
