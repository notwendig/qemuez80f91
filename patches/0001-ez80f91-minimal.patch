diff --git a/hw/ez80/rtc.c b/hw/ez80/rtc.c
new file mode 100644
--- /dev/null
+++ b/hw/ez80/rtc.c
@@ -0,0 +1,133 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* F91 RTC calendar counters. Alarm matching and sleep wakeup are not modeled. */
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/timer.h"
+#include "system/rtc.h"
+#include "system/system.h"
+#include "hw/core/sysbus.h"
+#include "system/address-spaces.h"
+
+#define TYPE_F91_RTC "ez80f91-rtc"
+OBJECT_DECLARE_SIMPLE_TYPE(F91RTCState, F91_RTC)
+struct F91RTCState {
+    SysBusDevice parent_obj;
+    MemoryRegion ports;
+    uint8_t r[14];
+    int64_t last_ns;
+};
+static unsigned decode(F91RTCState *s, unsigned value)
+{
+    return s->r[13] & 0x20 ? (value >> 4) * 10 + (value & 15) : value;
+}
+static uint8_t encode(F91RTCState *s, unsigned value)
+{
+    return s->r[13] & 0x20 ? (value / 10) * 16 + value % 10 : value;
+}
+static void store_calendar(F91RTCState *s, struct tm *tm, unsigned dow)
+{
+    unsigned year = tm->tm_year + 1900;
+    unsigned values[] = {tm->tm_sec, tm->tm_min, tm->tm_hour, dow,
+                         tm->tm_mday, tm->tm_mon + 1, year % 100, year / 100};
+    for (unsigned i = 0; i < 8; i++) {
+        s->r[i] = encode(s, values[i]);
+    }
+}
+static void sync_calendar(F91RTCState *s)
+{
+    int64_t now = qemu_clock_get_ns(rtc_clock);
+    int64_t seconds = (now - s->last_ns) / NANOSECONDS_PER_SECOND;
+    struct tm tm = {0};
+    unsigned dow, day_seconds;
+    time_t epoch;
+    if (s->r[13] & 1) {
+        s->last_ns = now;
+        return;
+    }
+    if (seconds <= 0) {
+        return;
+    }
+    s->last_ns += seconds * NANOSECONDS_PER_SECOND;
+    tm.tm_sec = decode(s, s->r[0]);
+    tm.tm_min = decode(s, s->r[1]);
+    tm.tm_hour = decode(s, s->r[2]);
+    tm.tm_mday = decode(s, s->r[4]);
+    tm.tm_mon = decode(s, s->r[5]) - 1;
+    tm.tm_year = decode(s, s->r[7]) * 100 + decode(s, s->r[6]) - 1900;
+    dow = decode(s, s->r[3]);
+    if (tm.tm_sec > 59 || tm.tm_min > 59 || tm.tm_hour > 23 ||
+        tm.tm_mday < 1 || tm.tm_mday > 31 || tm.tm_mon < 0 ||
+        tm.tm_mon > 11 || dow < 1 || dow > 7) {
+        return; /* Counting after invalid software values is unspecified. */
+    }
+    day_seconds = tm.tm_hour * 3600 + tm.tm_min * 60 + tm.tm_sec;
+    epoch = mktimegm(&tm) + seconds;
+    gmtime_r(&epoch, &tm);
+    dow = (dow - 1 + (day_seconds + seconds) / 86400) % 7 + 1;
+    store_calendar(s, &tm, dow);
+}
+static uint64_t rtc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    F91RTCState *s = opaque;
+    uint8_t value;
+    sync_calendar(s);
+    value = s->r[addr];
+    if (addr == 13) {
+        s->r[13] &= ~0x82; /* Alarm/wakeup status is read-to-clear. */
+    }
+    return value;
+}
+static void rtc_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    F91RTCState *s = opaque;
+    sync_calendar(s);
+    if (addr == 13) {
+        s->r[13] = (s->r[13] & 0x82) | (value & 0x7d);
+        s->last_ns = qemu_clock_get_ns(rtc_clock);
+    } else if (addr >= 8 || (s->r[13] & 1)) {
+        s->r[addr] = addr == 12 ? value & 15 : value;
+    }
+}
+static const MemoryRegionOps rtc_ops = {
+    .read = rtc_read,
+    .write = rtc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static void rtc_reset(Object *obj, ResetType type)
+{
+    F91RTCState *s = F91_RTC(obj);
+    sync_calendar(s);
+    s->r[13] &= ~0x43; /* Counter/alarm values survive CPU/system reset. */
+    s->r[12] = 0;
+    s->last_ns = qemu_clock_get_ns(rtc_clock);
+}
+static void rtc_init(Object *obj)
+{
+    F91RTCState *s = F91_RTC(obj);
+    struct tm tm;
+    qemu_get_timedate(&tm, 0);
+    /* Use ISO weekdays (Monday=1 .. Sunday=7) for the F91's 1..7 counter. */
+    store_calendar(s, &tm, tm.tm_wday ? tm.tm_wday : 7);
+    s->last_ns = qemu_clock_get_ns(rtc_clock);
+    memory_region_init_io(&s->ports, obj, &rtc_ops, s, "f91.rtc", 14);
+    memory_region_add_subregion(get_system_io(), 0xe0, &s->ports);
+}
+static void rtc_class_init(ObjectClass *oc, const void *data)
+{
+    RESETTABLE_CLASS(oc)->phases.hold = rtc_reset;
+    DEVICE_CLASS(oc)->user_creatable = false;
+}
+static const TypeInfo rtc_type = {
+    .name = TYPE_F91_RTC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(F91RTCState),
+    .instance_init = rtc_init,
+    .class_init = rtc_class_init,
+};
+static void rtc_register_types(void)
+{
+    type_register_static(&rtc_type);
+}
+type_init(rtc_register_types);
