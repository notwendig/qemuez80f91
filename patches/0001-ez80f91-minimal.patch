diff --git a/hw/ez80/timer.c b/hw/ez80/timer.c
new file mode 100644
--- /dev/null
+++ b/hw/ez80/timer.c
@@ -0,0 +1,264 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "qemu/log.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "system/address-spaces.h"
+
+#define TYPE_EZ80F91_TIMER0 "ez80f91-timer0"
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91TimerState, EZ80F91_TIMER0)
+
+typedef struct EZ80F91TimerChannel {
+    MemoryRegion ports;
+    QEMUTimer *timer;
+    qemu_irq irq;
+    EZ80F91TimerState *bank;
+    unsigned index;
+    uint32_t frequency, count;
+    uint16_t reload;
+    uint8_t ctl, ier, iir, latched_high;
+    int64_t deadline;
+} EZ80F91TimerChannel;
+
+struct EZ80F91TimerState {
+    SysBusDevice parent_obj;
+    MemoryRegion clock_port;
+    Clock *sclk;
+    uint32_t frequency;
+    uint8_t clock_ppd2;
+    EZ80F91TimerChannel channel[2];
+};
+static uint64_t tick_ns(EZ80F91TimerChannel *s)
+{
+    unsigned divider = 4u << (2 * ((s->ctl >> 3) & 3));
+    return DIV_ROUND_UP(1000000000ull * divider, s->frequency);
+}
+static void update_irq(EZ80F91TimerChannel *s)
+{
+    qemu_set_irq(s->irq, !!(s->ier & s->iir & 1));
+}
+static bool running(EZ80F91TimerChannel *s)
+{
+    return (s->ctl & 1) && !(s->bank->clock_ppd2 & (1u << s->index)) && !(s->ctl & 0x60);
+}
+static uint32_t current_count(EZ80F91TimerChannel *s)
+{
+    if (timer_pending(s->timer)) {
+        int64_t remaining = s->deadline - qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        return remaining > 0 ? DIV_ROUND_UP(remaining, tick_ns(s)) : 0;
+    }
+    return s->count;
+}
+static void schedule(EZ80F91TimerChannel *s)
+{
+    if (running(s)) {
+        uint32_t ticks = s->count ? s->count : 65536;
+        s->deadline = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)
+                    + ticks * tick_ns(s);
+        timer_mod(s->timer, s->deadline);
+    }
+}
+static void expire(void *opaque)
+{
+    EZ80F91TimerChannel *s = opaque;
+    s->iir |= 1;
+    if (s->ctl & 4) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        uint64_t period = (s->reload ? s->reload : 65536) * tick_ns(s);
+        s->count = s->reload ? s->reload : 65536;
+        /* Coalesce missed periods, preserving the phase and sticky EOC bit. */
+        s->deadline += ((now - s->deadline) / period + 1) * period;
+        timer_mod(s->timer, s->deadline);
+    } else {
+        s->ctl &= ~1;
+        s->count = 0;
+    }
+    update_irq(s);
+}
+static void sync_timer(EZ80F91TimerChannel *s)
+{
+    if (timer_pending(s->timer)
+        && qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->deadline) {
+        timer_del(s->timer);
+        expire(s);
+    }
+}
+static void sclk_changed(void *opaque, ClockEvent event)
+{
+    EZ80F91TimerState *bank = opaque;
+    for (unsigned i = 0; i < ARRAY_SIZE(bank->channel); i++) {
+        EZ80F91TimerChannel *s = &bank->channel[i];
+        if (event == ClockPreUpdate) {
+            sync_timer(s);
+            s->count = current_count(s);
+            timer_del(s->timer);
+        } else {
+            s->frequency = clock_get_hz(bank->sclk);
+            if (s->frequency) {
+                schedule(s);
+            }
+        }
+    }
+}
+static uint64_t timer_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91TimerChannel *s = opaque;
+    uint8_t value;
+    uint32_t count;
+    sync_timer(s);
+    switch (addr) {
+    case 0:
+        return s->ctl;
+    case 1:
+        return s->ier;
+    case 2:
+        value = s->iir;
+        s->iir = 0;
+        update_irq(s);
+        return value;
+    case 3:
+        count = current_count(s);
+        s->latched_high = count >> 8;
+        return count & 0xff;
+    case 4:
+        return s->latched_high;
+    default:
+        g_assert_not_reached();
+    }
+}
+static void timer_write(void *opaque, hwaddr addr, uint64_t value,
+                        unsigned size)
+{
+    EZ80F91TimerChannel *s = opaque;
+    sync_timer(s);
+    switch (addr) {
+    case 0:
+        s->count = current_count(s);
+        timer_del(s->timer);
+        s->ctl = value & ~2u;
+        if (value & 2) {
+            s->count = s->reload ? s->reload : 65536;
+        }
+        if (value & 0x60) {
+            qemu_log_mask(LOG_UNIMP, "F91 timer clock source unsupported\n");
+        }
+        schedule(s);
+        break;
+    case 1:
+        s->ier = value & 1;
+        update_irq(s);
+        break;
+    case 3:
+        s->reload = (s->reload & 0xff00) | (value & 0xff);
+        break;
+    case 4:
+        s->reload = (s->reload & 0xff) | ((value & 0xff) << 8);
+        break;
+    }
+}
+static uint64_t clock_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return EZ80F91_TIMER0(opaque)->clock_ppd2;
+}
+static void clock_write(void *opaque, hwaddr addr, uint64_t value,
+                        unsigned size)
+{
+    EZ80F91TimerState *bank = opaque;
+    for (unsigned i = 0; i < ARRAY_SIZE(bank->channel); i++) {
+        EZ80F91TimerChannel *s = &bank->channel[i];
+        sync_timer(s);
+        s->count = current_count(s);
+        timer_del(s->timer);
+    }
+    bank->clock_ppd2 = value & 0xcf;
+    for (unsigned i = 0; i < ARRAY_SIZE(bank->channel); i++) {
+        schedule(&bank->channel[i]);
+    }
+}
+#define PORT_OPS(readfn, writefn) { \
+    .read = readfn, .write = writefn, .endianness = DEVICE_LITTLE_ENDIAN, \
+    .valid = { .min_access_size = 1, .max_access_size = 1 }, \
+    .impl = { .min_access_size = 1, .max_access_size = 1 }, \
+}
+static const MemoryRegionOps timer_ops = PORT_OPS(timer_read, timer_write);
+static const MemoryRegionOps clock_ops = PORT_OPS(clock_read, clock_write);
+static void timer_reset(Object *obj, ResetType type)
+{
+    EZ80F91TimerState *s = EZ80F91_TIMER0(obj);
+    s->clock_ppd2 = 0;
+    for (unsigned i = 0; i < ARRAY_SIZE(s->channel); i++) {
+        EZ80F91TimerChannel *c = &s->channel[i];
+        timer_del(c->timer);
+        c->ctl = c->ier = c->iir = c->latched_high = 0;
+        c->count = c->reload = 0;
+        update_irq(c);
+    }
+}
+static void timer_realize(DeviceState *dev, Error **errp)
+{
+    EZ80F91TimerState *s = EZ80F91_TIMER0(dev);
+    if (clock_has_source(s->sclk)) {
+        s->frequency = clock_get_hz(s->sclk);
+    }
+    if (!s->frequency || s->frequency > 50000000) {
+        error_setg(errp, "F91 timer frequency must be 1..50000000 Hz");
+        return;
+    }
+    for (unsigned i = 0; i < ARRAY_SIZE(s->channel); i++) {
+        s->channel[i].frequency = s->frequency;
+    }
+}
+static void f91_timer_init(Object *obj)
+{
+    EZ80F91TimerState *s = EZ80F91_TIMER0(obj);
+    s->sclk = qdev_init_clock_in(DEVICE(s), "sclk", sclk_changed, s,
+                                ClockPreUpdate | ClockUpdate);
+    for (unsigned i = 0; i < ARRAY_SIZE(s->channel); i++) {
+        EZ80F91TimerChannel *c = &s->channel[i];
+        c->bank = s;
+        c->index = i;
+        c->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, expire, c);
+        sysbus_init_irq(SYS_BUS_DEVICE(s), &c->irq);
+        memory_region_init_io(&c->ports, obj, &timer_ops, c,
+                              i ? "f91.timer1" : "f91.timer0", 5);
+        memory_region_add_subregion(get_system_io(), 0x60 + 5 * i, &c->ports);
+    }
+    memory_region_init_io(&s->clock_port, obj, &clock_ops, s,
+                          "f91.clk-ppd2", 1);
+    memory_region_add_subregion(get_system_io(), 0xdc, &s->clock_port);
+}
+static void timer_finalize(Object *obj)
+{
+    EZ80F91TimerState *s = EZ80F91_TIMER0(obj);
+    for (unsigned i = 0; i < ARRAY_SIZE(s->channel); i++) {
+        timer_free(s->channel[i].timer);
+    }
+}
+static const Property timer_properties[] = {
+    DEFINE_PROP_UINT32("frequency", EZ80F91TimerState, frequency, 50000000),
+};
+static void timer_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = timer_realize;
+    device_class_set_props(dc, timer_properties);
+    RESETTABLE_CLASS(oc)->phases.hold = timer_reset;
+    dc->user_creatable = false;
+}
+static const TypeInfo timer_type = {
+    .name = TYPE_EZ80F91_TIMER0,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(EZ80F91TimerState),
+    .instance_init = f91_timer_init,
+    .instance_finalize = timer_finalize,
+    .class_init = timer_class_init,
+};
+static void timer_register_types(void)
+{
+    type_register_static(&timer_type);
+}
+type_init(timer_register_types);
diff --git a/hw/ez80/uart.c b/hw/ez80/uart.c
new file mode 100644
index 0000000..d70098e
--- /dev/null
+++ b/hw/ez80/uart.c
@@ -0,0 +1,332 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional eZ80F91 UART0, synchronous TX and buffered RX with interrupts. */
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties-system.h"
+#include "chardev/char-fe.h"
+#include "system/address-spaces.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-clock.h"
+
+#define TYPE_EZ80F91_UART "ez80f91-uart"
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91UARTState, EZ80F91_UART)
+
+struct EZ80F91UARTState {
+    SysBusDevice parent_obj;
+    MemoryRegion ports, gpio, clock;
+    CharFrontend chr;
+    uint8_t brg_l, brg_h, ier, lctl, mctl, spr;
+    uint8_t pd_ddr, pd_alt1, pd_alt2, clk_ppd1;
+    uint8_t fifo[16], head, count, fctl;
+    bool overrun, tx_pending, tc_pending, rx_timeout;
+    qemu_irq irq;
+    Clock *sclk;
+    QEMUTimer *rx_timer;
+};
+static bool pin_enabled(EZ80F91UARTState *s, unsigned bit)
+{
+    return !(s->clk_ppd1 & 0x81) && (s->pd_ddr & bit)
+        && !(s->pd_alt1 & bit) && (s->pd_alt2 & bit);
+}
+static unsigned rx_trigger(EZ80F91UARTState *s)
+{
+    static const unsigned levels[] = { 1, 4, 8, 14 };
+    return s->fctl & 1 ? levels[s->fctl >> 6] : 1;
+}
+static unsigned interrupt_code(EZ80F91UARTState *s)
+{
+    if (s->clk_ppd1 & 0x81) {
+        return 1;
+    }
+    if ((s->ier & 4) && s->overrun) {
+        return 6;
+    }
+    if ((s->ier & 1) && pin_enabled(s, 2)) {
+        if (s->count >= rx_trigger(s)) {
+            return 4;
+        }
+        if (s->count && s->rx_timeout) {
+            return 12;
+        }
+    }
+    if (pin_enabled(s, 1) && !(s->lctl & 0x40)) {
+        if ((s->ier & 0x10) && s->tc_pending) {
+            return 10;
+        }
+        if ((s->ier & 2) && s->tx_pending) {
+            return 2;
+        }
+    }
+    return 1;
+}
+static void uart_irq_update(EZ80F91UARTState *s)
+{
+    qemu_set_irq(s->irq, interrupt_code(s) != 1);
+}
+static void rx_expired(void *opaque)
+{
+    EZ80F91UARTState *s = opaque;
+    s->rx_timeout = s->count != 0;
+    uart_irq_update(s);
+}
+static void rx_restart(EZ80F91UARTState *s)
+{
+    uint64_t hz = clock_get_hz(s->sclk);
+    unsigned divider = s->brg_l | (s->brg_h << 8);
+    unsigned bits = 1 + 5 + (s->lctl & 3) + !!(s->lctl & 8) +
+                    ((s->lctl & 4) ? 2 : 1);
+    s->rx_timeout = false;
+    timer_del(s->rx_timer);
+    if (s->count && (s->fctl & 1) && hz) {
+        uint64_t ns = DIV_ROUND_UP(64000000000ull * MAX(divider, 1) * bits, hz);
+        timer_mod(s->rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+    }
+    uart_irq_update(s);
+}
+static int uart_can_receive(void *opaque)
+{
+    EZ80F91UARTState *s = opaque;
+    return pin_enabled(s, 2) && !(s->mctl & 0x10)
+        ? (s->fctl & 1 ? 16 : 1) - s->count : 0;
+}
+static void rx_push(EZ80F91UARTState *s, uint8_t value)
+{
+    unsigned capacity = s->fctl & 1 ? 16 : 1;
+    if (s->count < capacity) {
+        s->fifo[(s->head + s->count++) % 16] = value &
+            ((1u << (5 + (s->lctl & 3))) - 1);
+    } else {
+        s->overrun = true;
+    }
+    rx_restart(s);
+}
+static void uart_receive(void *opaque, const uint8_t *buf, int size)
+{
+    EZ80F91UARTState *s = opaque;
+    for (int i = 0; i < size; i++) {
+        rx_push(s, buf[i]);
+    }
+}
+static uint64_t uart_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91UARTState *s = opaque;
+    uint8_t value;
+    switch (addr) {
+    case 0:
+        if (s->lctl & 0x80) {
+            return s->brg_l;
+        }
+        value = 0;
+        if (s->count) {
+            value = s->fifo[s->head];
+            s->head = (s->head + 1) % 16;
+            s->count--;
+        }
+        rx_restart(s);
+        qemu_chr_fe_accept_input(&s->chr);
+        return value;
+    case 1:
+        return (s->lctl & 0x80) ? s->brg_h : s->ier;
+    case 2:
+        value = interrupt_code(s);
+        if (value == 2) {
+            s->tx_pending = false;
+            uart_irq_update(s);
+        }
+        return value | (s->fctl & 1 ? 0x80 : 0);
+    case 3:
+        return s->lctl;
+    case 4:
+        return s->mctl;
+    case 5:
+        value = (s->lctl & 0x40 ? 0 : 0x60) | !!s->count |
+                (s->overrun ? 2 : 0);
+        s->overrun = false;
+        uart_irq_update(s);
+        return value;
+    case 6:
+        if (s->mctl & 0x10) {
+            return ((s->mctl & 2) << 3) | ((s->mctl & 1) << 5) |
+                   ((s->mctl & 4) << 4) | ((s->mctl & 8) << 4);
+        }
+        /* A connected stream peer is always ready; no modem-edge model. */
+        return qemu_chr_fe_backend_connected(&s->chr) ? 0xb0 : 0;
+    case 7:
+        return s->spr;
+    default:
+        g_assert_not_reached();
+    }
+}
+static void uart_write(void *opaque, hwaddr addr, uint64_t value,
+                       unsigned size)
+{
+    EZ80F91UARTState *s = opaque;
+    uint8_t b = value;
+    switch (addr) {
+    case 0:
+        if (s->lctl & 0x80) {
+            s->brg_l = b;
+        } else if (pin_enabled(s, 1) && !(s->lctl & 0x40)) {
+            b &= (1u << (5 + (s->lctl & 3))) - 1;
+            if (s->mctl & 0x10) {
+                rx_push(s, b);
+            } else {
+                qemu_chr_fe_write_all(&s->chr, &b, 1);
+            }
+            s->tx_pending = s->tc_pending = true;
+        }
+        break;
+    case 1:
+        if (s->lctl & 0x80) {
+            s->brg_h = b;
+        } else {
+            if ((b & 2) && !(s->ier & 2)) {
+                s->tx_pending = true;
+            }
+            if ((b & 0x10) && !(s->ier & 0x10)) {
+                s->tc_pending = true;
+            }
+            s->ier = b & 0x1f;
+        }
+        break;
+    case 2:
+        if ((b ^ s->fctl) & 1 || (b & 2)) {
+            s->head = s->count = 0;
+            s->overrun = false;
+        }
+        s->fctl = b & 0xc1;
+        if (b & 4) {
+            s->tx_pending = true;
+        }
+        rx_restart(s);
+        qemu_chr_fe_accept_input(&s->chr);
+        break;
+    case 3:
+        s->lctl = b;
+        rx_restart(s);
+        break;
+    case 4:
+        s->mctl = b & 0x7f;
+        break;
+    case 7:
+        s->spr = b;
+        break;
+    }
+    uart_irq_update(s);
+}
+static uint64_t gpio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91UARTState *s = opaque;
+    switch (addr) {
+    case 0:
+        return s->pd_ddr;
+    case 1:
+        return s->pd_alt1;
+    case 2:
+        return s->pd_alt2;
+    default:
+        g_assert_not_reached();
+    }
+}
+static void gpio_write(void *opaque, hwaddr addr, uint64_t value,
+                       unsigned size)
+{
+    EZ80F91UARTState *s = opaque;
+    switch (addr) {
+    case 0:
+        s->pd_ddr = value;
+        break;
+    case 1:
+        s->pd_alt1 = value;
+        break;
+    case 2:
+        s->pd_alt2 = value;
+        break;
+    }
+    uart_irq_update(s);
+    qemu_chr_fe_accept_input(&s->chr);
+}
+static uint64_t clock_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return EZ80F91_UART(opaque)->clk_ppd1;
+}
+static void clock_write(void *opaque, hwaddr addr, uint64_t value,
+                        unsigned size)
+{
+    EZ80F91UARTState *s = opaque;
+    s->clk_ppd1 = value;
+    uart_irq_update(s);
+    qemu_chr_fe_accept_input(&s->chr);
+}
+#define PORT_OPS(readfn, writefn) { \
+    .read = readfn, .write = writefn, .endianness = DEVICE_LITTLE_ENDIAN, \
+    .valid = { .min_access_size = 1, .max_access_size = 1 }, \
+    .impl = { .min_access_size = 1, .max_access_size = 1 }, \
+}
+static const MemoryRegionOps uart_ops = PORT_OPS(uart_read, uart_write);
+static const MemoryRegionOps gpio_ops = PORT_OPS(gpio_read, gpio_write);
+static const MemoryRegionOps clock_ops = PORT_OPS(clock_read, clock_write);
+
+static void uart_reset(Object *obj, ResetType type)
+{
+    EZ80F91UARTState *s = EZ80F91_UART(obj);
+    s->brg_l = 2;
+    s->brg_h = s->ier = s->lctl = s->mctl = s->spr = 0;
+    s->head = s->count = s->fctl = 0;
+    s->overrun = s->rx_timeout = false;
+    s->tx_pending = s->tc_pending = true;
+    timer_del(s->rx_timer);
+    s->pd_ddr = 0xff;
+    s->pd_alt1 = s->pd_alt2 = s->clk_ppd1 = 0;
+    uart_irq_update(s);
+}
+static void uart_realize(DeviceState *dev, Error **errp)
+{
+    EZ80F91UARTState *s = EZ80F91_UART(dev);
+    qemu_chr_fe_set_handlers(&s->chr, uart_can_receive, uart_receive,
+                             NULL, NULL, s, NULL, true);
+}
+static void uart_init(Object *obj)
+{
+    EZ80F91UARTState *s = EZ80F91_UART(obj);
+    s->sclk = qdev_init_clock_in(DEVICE(s), "sclk", NULL, NULL, 0);
+    s->rx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, rx_expired, s);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+    memory_region_init_io(&s->ports, obj, &uart_ops, s, "uart0", 8);
+    memory_region_add_subregion(get_system_io(), 0xc0, &s->ports);
+    /* Only the Port D mux registers needed by UART0 are implemented. */
+    memory_region_init_io(&s->gpio, obj, &gpio_ops, s, "uart0-portd-mux", 3);
+    memory_region_add_subregion(get_system_io(), 0xa3, &s->gpio);
+    memory_region_init_io(&s->clock, obj, &clock_ops, s, "clk-ppd1", 1);
+    memory_region_add_subregion(get_system_io(), 0xdb, &s->clock);
+}
+static void uart_finalize(Object *obj)
+{
+    timer_free(EZ80F91_UART(obj)->rx_timer);
+}
+static const Property uart_properties[] = {
+    DEFINE_PROP_CHR("chardev", EZ80F91UARTState, chr),
+};
+static void uart_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = uart_realize;
+    device_class_set_props(dc, uart_properties);
+    RESETTABLE_CLASS(oc)->phases.hold = uart_reset;
+    dc->user_creatable = false;
+}
+static const TypeInfo uart_type = {
+    .name = TYPE_EZ80F91_UART,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(EZ80F91UARTState),
+    .instance_init = uart_init,
+    .instance_finalize = uart_finalize,
+    .class_init = uart_class_init,
+};
+static void uart_register_types(void)
+{
+    type_register_static(&uart_type);
+}
+type_init(uart_register_types);
