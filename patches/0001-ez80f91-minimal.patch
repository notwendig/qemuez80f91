diff --git a/hw/ez80/clock.c b/hw/ez80/clock.c
new file mode 100644
index 0000000..1116f59
--- /dev/null
+++ b/hw/ez80/clock.c
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional F91 clock mux and PLL; analog settling is not simulated. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "qemu/log.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-clock.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/irq.h"
+#include "system/address-spaces.h"
+
+#define TYPE_EZ80F91_CLOCK "ez80f91-clock"
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91ClockState, EZ80F91_CLOCK)
+
+struct EZ80F91ClockState {
+    SysBusDevice parent_obj;
+    MemoryRegion ports;
+    Clock *sclk;
+    QEMUTimer *lock_timer;
+    qemu_irq irq;
+    uint32_t oscillator;
+    uint16_t divider;
+    uint8_t div_low, ctl0, ctl1;
+};
+static void update_irq(EZ80F91ClockState *s)
+{
+    qemu_set_irq(s->irq, ((s->ctl1 & 0x10) && (s->ctl1 & 4))
+                      || ((s->ctl1 & 8) && (s->ctl1 & 2)));
+}
+static void update_clock(EZ80F91ClockState *s)
+{
+    unsigned source = s->ctl0 & 3;
+    unsigned frequency = source == 1 ? s->oscillator * s->divider
+                       : source == 2 ? 32768 : s->oscillator;
+    clock_update_hz(s->sclk, frequency);
+}
+static void locked(void *opaque)
+{
+    EZ80F91ClockState *s = opaque;
+    if (s->ctl1 & 1) {
+        s->ctl1 |= 0x30;
+        update_irq(s);
+    }
+}
+static void sync_lock(EZ80F91ClockState *s)
+{
+    if (timer_pending(s->lock_timer)
+        && qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)
+           >= timer_expire_time_ns(s->lock_timer)) {
+        timer_del(s->lock_timer);
+        locked(s);
+    }
+}
+static uint64_t clock_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91ClockState *s = opaque;
+    uint8_t value;
+    sync_lock(s);
+    if (addr < 2) {
+        return 0; /* Divider registers are write only. */
+    }
+    if (addr == 2) {
+        return s->ctl0;
+    }
+    value = s->ctl1;
+    s->ctl1 &= ~0x18; /* Lock/unlock events are read-to-clear. */
+    update_irq(s);
+    return value;
+}
+static void clock_write(void *opaque, hwaddr addr, uint64_t value,
+                        unsigned size)
+{
+    EZ80F91ClockState *s = opaque;
+    sync_lock(s);
+    if (addr < 2) {
+        if (!(s->ctl1 & 1)) {
+            if (addr == 0) {
+                s->div_low = value;
+            } else {
+                s->divider = MAX(2, ((value & 7) << 8) | s->div_low);
+            }
+        }
+    } else if (addr == 2) {
+        unsigned source = value & 3;
+        if (source == 3 || (source == 1 && !(s->ctl1 & 0x20))) {
+            source = s->ctl0 & 3;
+        }
+        if (!(s->ctl1 & 1)) {
+            s->ctl0 = value & 0xcc;
+        }
+        s->ctl0 = (s->ctl0 & ~3u) | source;
+        update_clock(s);
+    } else {
+        bool enable = (value & 1) || (s->ctl0 & 3) == 1;
+        bool was_enabled = s->ctl1 & 1;
+        s->ctl1 = (s->ctl1 & 0x38) | (value & 6) | enable;
+        if (enable && !was_enabled) {
+            uint64_t frequency = (uint64_t)s->oscillator * s->divider;
+            if (s->oscillator >= 1000000 && s->oscillator <= 10000000
+                && frequency <= 50000000) {
+                /* Deterministic functional delay, not an analog lock time. */
+                timer_mod(s->lock_timer,
+                          qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100000);
+            } else {
+                qemu_log_mask(LOG_UNIMP,
+                              "F91 PLL input/output outside supported range\n");
+            }
+        } else if (!enable && was_enabled) {
+            timer_del(s->lock_timer);
+            if (s->ctl1 & 0x20) {
+                s->ctl1 = (s->ctl1 & ~0x20) | 8;
+            }
+        }
+        update_irq(s);
+    }
+}
+static const MemoryRegionOps clock_ops = {
+    .read = clock_read,
+    .write = clock_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static void clock_reset(Object *obj, ResetType type)
+{
+    EZ80F91ClockState *s = EZ80F91_CLOCK(obj);
+    timer_del(s->lock_timer);
+    s->divider = s->div_low = 2;
+    s->ctl0 = s->ctl1 = 0;
+    update_clock(s);
+    update_irq(s);
+}
+static void clock_realize(DeviceState *dev, Error **errp)
+{
+    EZ80F91ClockState *s = EZ80F91_CLOCK(dev);
+    if (!s->oscillator || s->oscillator > 50000000) {
+        error_setg(errp, "F91 oscillator must be 1..50000000 Hz");
+        return;
+    }
+    clock_set_hz(s->sclk, s->oscillator);
+}
+static void clock_init(Object *obj)
+{
+    EZ80F91ClockState *s = EZ80F91_CLOCK(obj);
+    s->sclk = qdev_init_clock_out(DEVICE(s), "sclk");
+    s->lock_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, locked, s);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+    memory_region_init_io(&s->ports, obj, &clock_ops, s, "f91.pll", 4);
+    memory_region_add_subregion(get_system_io(), 0x5c, &s->ports);
+}
+static void clock_finalize(Object *obj)
+{
+    timer_free(EZ80F91_CLOCK(obj)->lock_timer);
+}
+static const Property clock_properties[] = {
+    DEFINE_PROP_UINT32("osc-frequency", EZ80F91ClockState,
+                       oscillator, 50000000),
+};
+static void clock_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = clock_realize;
+    device_class_set_props(dc, clock_properties);
+    RESETTABLE_CLASS(oc)->phases.hold = clock_reset;
+    dc->user_creatable = false;
+}
+static const TypeInfo clock_type = {
+    .name = TYPE_EZ80F91_CLOCK,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(EZ80F91ClockState),
+    .instance_init = clock_init,
+    .instance_finalize = clock_finalize,
+    .class_init = clock_class_init,
+};
+static void clock_register_types(void)
+{
+    type_register_static(&clock_type);
+}
+type_init(clock_register_types);
