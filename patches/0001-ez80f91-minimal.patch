diff --git a/target/ez80/cpu.c b/target/ez80/cpu.c
new file mode 100644
index 0000000..89b5d47
--- /dev/null
+++ b/target/ez80/cpu.c
@@ -0,0 +1,205 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "cpu.h"
+#include "exec/cpu-interrupt.h"
+#include "exec/translation-block.h"
+#include "exec/page-protection.h"
+#include "exec/cputlb.h"
+#include "exec/target_page.h"
+#include "accel/tcg/cpu-ops.h"
+#include "hw/core/sysemu-cpu-ops.h"
+#include "qemu/qemu-print.h"
+#include "migration/vmstate.h"
+
+static void ez80_set_pc(CPUState *cs, vaddr pc)
+{
+    cpu_env(cs)->pc = pc & EZ80_ADDR_MASK;
+}
+static vaddr ez80_get_pc(CPUState *cs)
+{
+    return cpu_env(cs)->pc;
+}
+static bool ez80_has_work(CPUState *cs)
+{
+    CPUEZ80State *e = cpu_env(cs);
+    return cpu_test_interrupt(cs, CPU_INTERRUPT_HARD)
+        && e->iff1 && !e->ei_delay && !e->sleeping;
+}
+static bool ez80_exec_interrupt(CPUState *cs, int request)
+{
+    CPUEZ80State *e = cpu_env(cs);
+    if ((request & CPU_INTERRUPT_HARD) && e->iff1
+        && !e->ei_delay && !e->sleeping) {
+        cs->halted = 0;
+        ez80_cpu_take_interrupt(e);
+        return true;
+    }
+    return false;
+}
+
+static int ez80_mmu_index(CPUState *cs, bool ifetch)
+{
+    return 0;
+}
+static TCGTBCPUState ez80_tb_state(CPUState *cs)
+{
+    CPUEZ80State *env = cpu_env(cs);
+    return (TCGTBCPUState) {
+        .pc = env->pc,
+        .flags = env->adl | (env->mbase << 8),
+    };
+}
+static void ez80_sync_tb(CPUState *cs, const TranslationBlock *tb)
+{
+    cpu_env(cs)->pc = tb->pc;
+}
+static void ez80_restore(CPUState *cs, const TranslationBlock *tb,
+                          const uint64_t *data)
+{
+    cpu_env(cs)->pc = data[0];
+}
+static bool ez80_tlb_fill(CPUState *cs, vaddr addr, int size,
+                          MMUAccessType type, int idx, bool probe,
+                          uintptr_t retaddr)
+{
+    vaddr page = addr & TARGET_PAGE_MASK;
+    tlb_set_page(cs, page, page, PAGE_READ | PAGE_WRITE | PAGE_EXEC,
+                 idx, TARGET_PAGE_SIZE);
+    return true;
+}
+static hwaddr ez80_phys_debug(CPUState *cs, vaddr addr)
+{
+    return addr & EZ80_ADDR_MASK;
+}
+static void ez80_reset_hold(Object *obj, ResetType type)
+{
+    EZ80CPUClass *ecc = EZ80_CPU_GET_CLASS(obj);
+    CPUEZ80State *env = cpu_env(CPU(obj));
+    if (ecc->parent_phases.hold) {
+        ecc->parent_phases.hold(obj, type);
+    }
+    /* Undefined working registers retain their state on reset. */
+    env->pc = 0;
+    env->adl = 0;
+    env->mbase = 0;
+    env->madl = 0;
+    env->iff1 = env->iff2 = 0;
+    env->im = 0;
+    env->ei_delay = env->sleeping = 0;
+    env->irq_vector = 0;
+    env->ix = env->iy = 0;
+    env->sps = env->spl = 0;
+    env->i = env->r = 0;
+}
+static void ez80_realize(DeviceState *dev, Error **errp)
+{
+    CPUState *cs = CPU(dev);
+    EZ80CPUClass *ecc = EZ80_CPU_GET_CLASS(dev);
+    Error *err = NULL;
+    cpu_exec_realizefn(cs, &err);
+    if (err) {
+        error_propagate(errp, err);
+        return;
+    }
+    qemu_init_vcpu(cs);
+    cpu_reset(cs);
+    ecc->parent_realize(dev, errp);
+}
+static void ez80_set_irq(void *opaque, int line, int level)
+{
+    CPUState *cs = opaque;
+    CPUEZ80State *e = cpu_env(cs);
+    if (line == 0) {
+        if (level) {
+            cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+        } else {
+            cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+        }
+    } else {
+        uint16_t bit = 1u << (line - 1);
+        e->irq_vector = (e->irq_vector & ~bit) | (level ? bit : 0);
+    }
+}
+static void ez80_init(Object *obj)
+{
+    qdev_init_gpio_in(DEVICE(obj), ez80_set_irq, 10);
+}
+static ObjectClass *ez80_class_by_name(const char *name)
+{
+    g_autofree char *type = g_strdup_printf("%s-ez80-cpu", name);
+    return object_class_by_name(type);
+}
+static void ez80_dump_state(CPUState *cs, FILE *f, int flags)
+{
+    CPUEZ80State *e = cpu_env(cs);
+    qemu_fprintf(f, "PC=%06x ADL=%u MBASE=%02x MADL=%u HALTED=%u SLEEP=%u\n",
+                 e->pc, e->adl, e->mbase, e->madl, cs->halted, e->sleeping);
+    qemu_fprintf(f, "AF=%02x%02x BC=%06x DE=%06x HL=%06x IX=%06x IY=%06x\n",
+                 e->a, e->f, e->bc, e->de, e->hl, e->ix, e->iy);
+    qemu_fprintf(f, "SPS=%04x SPL=%06x I=%04x R=%02x IFF1=%u IFF2=%u IM=%u\n",
+                 e->sps, e->spl, e->i, e->r, e->iff1, e->iff2, e->im);
+}
+static const SysemuCPUOps ez80_sysemu_ops = {
+    .has_work = ez80_has_work,
+    .get_phys_addr_debug = ez80_phys_debug,
+};
+static const TCGCPUOps ez80_tcg_ops = {
+    .guest_default_memory_order = 0,
+    .mttcg_supported = false,
+    .initialize = ez80_translate_init,
+    .translate_code = ez80_translate_code,
+    .get_tb_cpu_state = ez80_tb_state,
+    .synchronize_from_tb = ez80_sync_tb,
+    .restore_state_to_opc = ez80_restore,
+    .mmu_index = ez80_mmu_index,
+    .cpu_exec_interrupt = ez80_exec_interrupt,
+    .cpu_exec_halt = ez80_has_work,
+    .cpu_exec_reset = cpu_reset,
+    .tlb_fill = ez80_tlb_fill,
+    .pointer_wrap = cpu_pointer_wrap_uint32,
+};
+static const VMStateDescription ez80_vmstate = {
+    .name = "ez80-cpu",
+    .unmigratable = true,
+};
+
+static void ez80_class_init(ObjectClass *oc, const void *data)
+{
+    CPUClass *cc = CPU_CLASS(oc);
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    EZ80CPUClass *ecc = EZ80_CPU_CLASS(oc);
+    device_class_set_parent_realize(dc, ez80_realize, &ecc->parent_realize);
+    resettable_class_set_parent_phases(RESETTABLE_CLASS(oc), NULL,
+                                      ez80_reset_hold, NULL,
+                                      &ecc->parent_phases);
+    cc->class_by_name = ez80_class_by_name;
+    cc->set_pc = ez80_set_pc;
+    cc->get_pc = ez80_get_pc;
+    cc->dump_state = ez80_dump_state;
+    cc->gdb_read_register = ez80_cpu_gdb_read_register;
+    cc->gdb_write_register = ez80_cpu_gdb_write_register;
+    cc->gdb_num_core_regs = 24;
+    cc->memory_rw_debug = ez80_cpu_memory_rw_debug;
+    cc->sysemu_ops = &ez80_sysemu_ops;
+    cc->tcg_ops = &ez80_tcg_ops;
+    /* Migration requires complete CPU and SoC state. */
+    dc->vmsd = &ez80_vmstate;
+    dc->user_creatable = false;
+}
+static const TypeInfo ez80_types[] = {
+    {
+        .name = TYPE_EZ80_CPU,
+        .parent = TYPE_CPU,
+        .instance_size = sizeof(EZ80CPU),
+        .instance_align = __alignof(EZ80CPU),
+        .instance_init = ez80_init,
+        .class_size = sizeof(EZ80CPUClass),
+        .class_init = ez80_class_init,
+        .abstract = true,
+    }, {
+        .name = EZ80_CPU_TYPE_NAME("ez80f91"),
+        .parent = TYPE_EZ80_CPU,
+    },
+};
+DEFINE_TYPES(ez80_types)
