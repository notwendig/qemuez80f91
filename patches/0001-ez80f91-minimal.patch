@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef EZ80_CPU_H
+#define EZ80_CPU_H
+#include "cpu-qom.h"
+#include "exec/cpu-common.h"
+#define CPU_RESOLVING_TYPE TYPE_EZ80_CPU
+#define EZ80_ADDR_MASK 0xffffffu
+#define EZ80_MLONG (1u << 0)
+#define EZ80_ILONG (1u << 1)
+#define EZ80_PREFIX (1u << 2)
+#define EZ80_INDEX_SHIFT 3
+#define EZ80_ED (1u << 5)
+#define EZ80_CB (1u << 6)
+#define EZ80_R_SHIFT 8
+
+typedef struct CPUArchState {
+    uint32_t pc;
+    uint32_t bc, de, hl, ix, iy;
+    uint32_t bc_shadow, de_shadow, hl_shadow;
+    uint32_t spl;
+    uint16_t sps, i, irq_vector;
+    uint8_t a, f, a_shadow, f_shadow, r;
+    uint8_t mbase, adl, madl, iff1, iff2, im, ei_delay, sleeping;
+} CPUEZ80State;
+
+struct ArchCPU {
+    CPUState parent_obj;
+    CPUEZ80State env;
+};
+struct EZ80CPUClass {
+    CPUClass parent_class;
+    DeviceRealize parent_realize;
+    ResettablePhases parent_phases;
+};
+void ez80_cpu_take_interrupt(CPUEZ80State *env);
+void ez80_translate_init(void);
+void ez80_translate_code(CPUState *, TranslationBlock *, int *, vaddr, void *);
+int ez80_cpu_gdb_read_register(CPUState *, GByteArray *, int);
+int ez80_cpu_gdb_write_register(CPUState *, uint8_t *, int);
+int ez80_cpu_memory_rw_debug(CPUState *, vaddr, uint8_t *, size_t, bool);
+#endif
diff --git a/target/ez80/decode.h b/target/ez80/decode.h
new file mode 100644
--- /dev/null
+++ b/target/ez80/decode.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef EZ80_DECODE_H
+#define EZ80_DECODE_H
+#include "cpu.h"
+typedef struct EZ80Decode {
+    uint8_t (*read)(void *opaque, uint32_t address);
+    void *opaque;
+    uint32_t cursor, arg, mode;
+    unsigned op;
+    bool adl, valid;
+} EZ80Decode;
+static inline uint8_t fetch(EZ80Decode *ctx)
+{
+    uint8_t b = ctx->read(ctx->opaque, ctx->cursor);
+    ctx->cursor = ctx->adl ? (ctx->cursor + 1) & EZ80_ADDR_MASK
+        : (ctx->cursor & 0xff0000) | ((ctx->cursor + 1) & 0xffff);
+    return b;
+}
+/* The byte which failed decoding, preserving the Z80 bank on PC wrap. */
+static inline uint32_t ez80_illegal_pc(const EZ80Decode *ctx)
+{
+    return ctx->adl ? (ctx->cursor - 1) & EZ80_ADDR_MASK
+        : (ctx->cursor & 0xff0000) | ((ctx->cursor - 1) & 0xffff);
+}
+static inline uint32_t immediate(EZ80Decode *ctx, unsigned size)
+{
+    uint32_t value = 0;
+    for (unsigned i = 0; i < size; i++) {
+        value |= (uint32_t)fetch(ctx) << (8 * i);
+    }
+    return value;
+}
+static inline bool ez80_block_io(unsigned op)
+{
+    return (op & 0xe6) == 0xa2 || (op & 0xe6) == 0x82
+        || (op & 0xf6) == 0xc2 || (op & 0xc7) == 0x84;
+}
+static inline bool ez80_index_byte(unsigned op)
+{
+    unsigned dst = (op >> 3) & 7, src = op & 7;
+    return op == 0x24 || op == 0x25 || op == 0x26
+        || op == 0x2c || op == 0x2d || op == 0x2e
+        || (op >= 0x80 && op <= 0xbf && (src == 4 || src == 5))
+        || (op >= 0x40 && op <= 0x7f && dst != 6 && src != 6
+            && (dst == 4 || dst == 5 || src == 4 || src == 5));
+}
+static inline bool ez80_halt(unsigned op, unsigned mode)
+{
+    return op == 0x76 && !(mode & EZ80_CB)
+        && !((mode >> EZ80_INDEX_SHIFT) & 3);
+}
+static inline void ez80_decode(EZ80Decode *ctx)
+{
+    uint32_t pc = ctx->cursor, arg = 0;
+    uint32_t mode = ctx->adl ? EZ80_MLONG | EZ80_ILONG : 0;
+    unsigned r_count = 1, index = 0;
+    uint8_t op;
+    bool valid = false;
+
+    ctx->cursor = pc;
+    op = fetch(ctx);
+    if (op == 0x40 || op == 0x49 || op == 0x52 || op == 0x5b) {
+        mode = EZ80_PREFIX | ((op & 8) ? EZ80_MLONG : 0)
+             | ((op & 0x10) ? EZ80_ILONG : 0);
+        op = fetch(ctx);
+        r_count++;
+    }
+    if (op == 0xdd || op == 0xfd) {
+        index = op == 0xdd ? 1 : 2;
+        mode |= index << EZ80_INDEX_SHIFT;
+        op = fetch(ctx);
+        r_count++;
+    }
+    if (op == 0xcb) {
+        if (index) {
+            arg = fetch(ctx);
+        } else {
+            r_count++;
+        }
+        op = fetch(ctx);
+        mode |= EZ80_CB;
+        valid = (op < 0x30 || op >= 0x38)
+             && ((!index && !(mode & EZ80_PREFIX)) || (op & 7) == 6);
+    } else if (op == 0xed && !index) {
+        op = fetch(ctx);
+        r_count++;
+        if (((op & 0xc7) == 0x00 || (op & 0xc7) == 0x01)
+            && ((op >> 3) & 7) != 6) {
+            arg = fetch(ctx);
+            valid = true; /* IN0/OUT0 r,(n) */
+        } else if (op == 0x64 || op == 0x74) {
+            arg = fetch(ctx);
+            valid = !(mode & EZ80_PREFIX);
+        } else if ((op & 0xcf) == 0x43 || (op & 0xcf) == 0x4b) {
+            arg = immediate(ctx, (mode & EZ80_ILONG) ? 3 : 2);
+            valid = true;
+        } else if (op == 0x02 || op == 0x12 || op == 0x22
+                   || op == 0x03 || op == 0x13 || op == 0x23
+                   || op == 0x32 || op == 0x33 || op == 0x54 || op == 0x55
+                   || op == 0x65 || op == 0x66) {
+            arg = fetch(ctx);
+            valid = true;
+        } else if ((op & 0xcf) == 0x42 || (op & 0xcf) == 0x4a
+                   || (op & 0xe6) == 0xa0 || op == 0x47 || op == 0x57
+                   || op == 0xc7 || op == 0x46 || op == 0x56 || op == 0x5e
+                   || op == 0x4d || op == 0x07 || op == 0x17 || op == 0x27
+                   || op == 0x0f || op == 0x1f || op == 0x2f
+                   || op == 0x31 || op == 0x37 || op == 0x3e || op == 0x3f
+                   || (op & 0xcf) == 0x4c
+                   || op == 0x6d || op == 0x6e || op == 0x7d || op == 0x7e
+                   || op == 0x44 || op == 0x45 || op == 0x4f || op == 0x5f
+                   || op == 0xd7 || op == 0x67 || op == 0x6f || op == 0x76
+                   || (op & 0xc7) == 0x04 || ez80_block_io(op)
+                   || (((op & 0xc7) == 0x40 || (op & 0xc7) == 0x41)
+                       && ((op >> 3) & 7) != 6)) {
+            valid = true;
+        }
+        mode |= EZ80_ED;
+    } else if (index) {
+        if (ez80_index_byte(op)) {
+            if (op == 0x26 || op == 0x2e) {
+                arg = fetch(ctx);
+            }
+            valid = !(mode & EZ80_PREFIX);
+        } else if (op == 0x21 || op == 0x22 || op == 0x2a) {
+            arg = immediate(ctx, (mode & EZ80_ILONG) ? 3 : 2);
+            valid = true;
+        } else if (op == 0x07 || op == 0x17 || op == 0x27
+                   || op == 0x0f || op == 0x1f || op == 0x2f
+                   || (op >= 0x70 && op <= 0x77 && op != 0x76)
+                   || ((op & 0xc7) == 0x46 && op != 0x76) || op == 0x36
+                   || op == 0x34 || op == 0x35
+                   || (op >= 0x80 && op <= 0xbf && (op & 7) == 6)
+                   || op == 0x31 || op == 0x37 || op == 0x3e || op == 0x3f) {
+            arg = fetch(ctx);
+            if (op == 0x36) {
+                arg |= (uint32_t)fetch(ctx) << 8;
+            }
+            valid = true;
+        } else if (op == 0xe1 || op == 0xe5 || op == 0xe9 || op == 0xf9
+                   || op == 0x23 || op == 0x2b || op == 0xe3
+                   || (op & 0xcf) == 0x09) {
+            valid = true;
+        }
+    } else if ((op & 0xcf) == 0x01) {
+        arg = immediate(ctx, (mode & EZ80_ILONG) ? 3 : 2);
+        valid = true; /* LD rr,nn */
+    } else if ((op & 0xc7) == 0x06) {
+        arg = fetch(ctx);
+        valid = true; /* LD r,n and LD (HL),n */
+    } else if ((op >= 0x40 && op <= 0x7f) || op == 0x00
+               || (op & 0xcf) == 0x03 || (op & 0xcf) == 0x0b
+               || (op & 0xcf) == 0xc1 || (op & 0xcf) == 0xc5
+               || op == 0xf9 || op == 0xeb || op == 0xe9
+               || op == 0xc9 || (op & 0xc7) == 0xc0 || op == 0xf3 || op == 0xfb
+               || op == 0x02 || op == 0x0a || op == 0x12 || op == 0x1a
+               || op == 0xe3 || op == 0x08 || op == 0xd9 || op == 0x37
+               || op == 0x07 || op == 0x0f || op == 0x17 || op == 0x1f
+               || op == 0x2f || op == 0x27 || op == 0x3f
+               || (op & 0xc7) == 0xc7
+               || (op & 0xcf) == 0x09 || (op >= 0x80 && op <= 0xbf)
+               || (op & 0xc7) == 0x04 || (op & 0xc7) == 0x05) {
+        valid = true;
+    } else if (op == 0xc3 || op == 0xcd || op == 0x32 || op == 0x3a
+               || op == 0x22 || op == 0x2a
+               || (op & 0xc7) == 0xc2 || (op & 0xc7) == 0xc4) {
+        arg = immediate(ctx, (mode & EZ80_ILONG) ? 3 : 2);
+        valid = true;
+    } else if (op == 0xdb || op == 0xd3) {
+        arg = fetch(ctx);
+        valid = !(mode & EZ80_PREFIX);
+    } else if (op == 0x10 || op == 0x18 || op == 0x20 || op == 0x28
+               || op == 0x30 || op == 0x38 || op == 0xe6 || op == 0xf6
+               || op == 0xee || op == 0xfe || op == 0xc6 || op == 0xce
+               || op == 0xd6 || op == 0xde) {
+        arg = fetch(ctx);
+        valid = !(mode & EZ80_PREFIX);
+    } else if (op == 0xaf || op == 0xb7) {
+        valid = !(mode & EZ80_PREFIX);
+    }
+    /* Avoid accepting unrelated index/size prefixes as ordinary opcodes. */
+    if ((mode & EZ80_PREFIX) && !(mode & EZ80_CB)
+        && !(mode & EZ80_ED)
+        && (op == 0x00 || op == 0x76 || op == 0xf3 || op == 0xeb
+            || (!index && (op == 0x27 || op == 0x3f)))) {
+        valid = false;
+    }
+    if ((op == 0xc3 || op == 0xe9) && !(mode & EZ80_ED)) {
+        /* Immediate JP allows SIS/LIL; register JP allows either IS/IL. */
+        if (op == 0xc3 && !!(mode & EZ80_MLONG) != !!(mode & EZ80_ILONG)) {
+            valid = false;
+        }
+    }
+    if (op == 0xc9 && (mode & EZ80_PREFIX) && !(mode & EZ80_MLONG)) {
+        valid = false; /* RET.S is invalid for mixed-mode frames. */
+    }
+    if ((mode & EZ80_ED) && (op == 0x4d || op == 0x45)
+        && (mode & EZ80_PREFIX) && !(mode & EZ80_MLONG)) {
+        valid = false;
+    }
+    if ((mode & EZ80_ED) && (mode & EZ80_PREFIX)
+        && (op == 0x44 || op == 0x4f || op == 0x5f || op == 0xd7
+            || op == 0x76 || ((op & 0xc7) == 0x04 && op != 0x34))) {
+        valid = false;
+    }
+    ctx->op = op;
+    ctx->arg = arg;
+    ctx->mode = mode | (r_count << EZ80_R_SHIFT);
+    ctx->valid = valid;
+}
+#endif
diff --git a/target/ez80/gdbstub.c b/target/ez80/gdbstub.c
new file mode 100644
index 0000000..e1b322b
--- /dev/null
+++ b/target/ez80/gdbstub.c
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "gdbstub/helpers.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "exec/cpu-common.h"
+/* Private debugger ABI: 24 little-endian 32-bit slots. */
+int ez80_cpu_gdb_read_register(CPUState *cs, GByteArray *buf, int n)
+{
+    CPUEZ80State *e = cpu_env(cs);
+    switch (n) {
+    case 0: return gdb_get_reg32(buf, e->pc);
+    case 1: return gdb_get_reg32(buf, e->bc);
+    case 2: return gdb_get_reg32(buf, e->de);
+    case 3: return gdb_get_reg32(buf, e->hl);
+    case 4: return gdb_get_reg32(buf, e->ix);
+    case 5: return gdb_get_reg32(buf, e->iy);
+    case 6: return gdb_get_reg32(buf, e->bc_shadow);
+    case 7: return gdb_get_reg32(buf, e->de_shadow);
+    case 8: return gdb_get_reg32(buf, e->hl_shadow);
+    case 9: return gdb_get_reg32(buf, e->spl);
+    case 10: return gdb_get_reg32(buf, e->sps);
+    case 11: return gdb_get_reg32(buf, e->i);
+    case 12: return gdb_get_reg32(buf, e->a);
+    case 13: return gdb_get_reg32(buf, e->f);
+    case 14: return gdb_get_reg32(buf, e->a_shadow);
+    case 15: return gdb_get_reg32(buf, e->f_shadow);
+    case 16: return gdb_get_reg32(buf, e->r);
+    case 17: return gdb_get_reg32(buf, e->mbase);
+    case 18: return gdb_get_reg32(buf, e->adl);
+    case 19: return gdb_get_reg32(buf, e->madl);
+    case 20: return gdb_get_reg32(buf, e->iff1);
+    case 21: return gdb_get_reg32(buf, e->iff2);
+    case 22: return gdb_get_reg32(buf, e->im);
+    case 23: return gdb_get_reg32(buf, e->ei_delay);
+    default: return 0;
+    }
+}
+int ez80_cpu_gdb_write_register(CPUState *cs, uint8_t *buf, int n)
+{
+    CPUEZ80State *e = cpu_env(cs);
+    uint32_t value = ldl_le_p(buf);
+    switch (n) {
+    case 0:
+        e->pc = value & 0xffffff;
+        break;
+    case 1:
+        e->bc = value & 0xffffff;
+        break;
+    case 2:
+        e->de = value & 0xffffff;
+        break;
+    case 3:
+        e->hl = value & 0xffffff;
+        break;
+    case 4:
+        e->ix = value & 0xffffff;
+        break;
+    case 5:
+        e->iy = value & 0xffffff;
+        break;
+    case 6:
+        e->bc_shadow = value & 0xffffff;
+        break;
+    case 7:
+        e->de_shadow = value & 0xffffff;
+        break;
+    case 8:
+        e->hl_shadow = value & 0xffffff;
+        break;
+    case 9:
+        e->spl = value & 0xffffff;
+        break;
+    case 10:
+        e->sps = value & 0xffff;
+        break;
+    case 11:
+        e->i = value & 0xffff;
+        break;
+    case 12:
+        e->a = value & 0xff;
+        break;
+    case 13:
+        e->f = value & 0xff;
+        break;
+    case 14:
+        e->a_shadow = value & 0xff;
+        break;
+    case 15:
+        e->f_shadow = value & 0xff;
+        break;
+    case 16:
+        e->r = value & 0xff;
+        break;
+    case 17:
+        e->mbase = value & 0xff;
+        break;
+    case 18:
+        e->adl = value & 1;
+        break;
+    case 19:
+        e->madl = value & 1;
+        break;
+    case 20:
+        e->iff1 = value & 1;
+        break;
+    case 21:
+        e->iff2 = value & 1;
+        break;
+    case 22:
+        e->im = value & 3;
+        break;
+    case 23:
+        e->ei_delay = value & 0xff;
+        break;
+    default: return 0;
+    }
+    return 4;
+}
+/* A private debug-only window exposes the 16-bit port space. */
+int ez80_cpu_memory_rw_debug(CPUState *cs, vaddr addr, uint8_t *buf,
+                            size_t len, bool is_write)
+{
+    if (addr >= 0x1000000 && addr < 0x1010000) {
+        if (len > 0x1010000 - addr) {
+            return -1;
+        }
+        return address_space_rw(&address_space_io, addr - 0x1000000,
+                                MEMTXATTRS_UNSPECIFIED, buf, len, is_write)
+               == MEMTX_OK ? 0 : -1;
+    }
+    return cpu_memory_rw_debug(cs, addr, buf, len, is_write);
+}
diff --git a/target/ez80/helper.c b/target/ez80/helper.c
new file mode 100644
--- /dev/null
+++ b/target/ez80/helper.c
@@ -0,0 +1,903 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "decode.h"
+#include "exec/helper-proto.h"
+#include "accel/tcg/cpu-loop.h"
+#include "accel/tcg/cpu-ldst.h"
+#include "accel/tcg/cpu-ldst-common.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "qemu/error-report.h"
+
+#define FLAG_C 0x01
+#define FLAG_N 0x02
+#define FLAG_PV 0x04
+#define FLAG_H 0x10
+#define FLAG_Z 0x40
+#define FLAG_S 0x80
+
+void helper_halt(CPUEZ80State *env)
+{
+    CPUState *cs = env_cpu(env);
+    cs->halted = 1;
+    cs->exception_index = EXCP_HLT;
+    cpu_loop_exit(cs);
+}
+void helper_unsupported(CPUEZ80State *env, uint32_t pc, uint32_t opcode)
+{
+    error_report("eZ80F91: unsupported opcode %02x at PC=%06x", opcode, pc);
+    exit(EXIT_FAILURE);
+}
+static uint32_t address(CPUEZ80State *e, uint32_t value, bool long_mode)
+{
+    return long_mode ? value & EZ80_ADDR_MASK
+                     : (e->mbase << 16) | (value & 0xffff);
+}
+static uint32_t *pair(CPUEZ80State *e, unsigned reg, unsigned index)
+{
+    switch (reg) {
+    case 0:
+        return &e->bc;
+    case 1:
+        return &e->de;
+    case 2:
+        return index == 1 ? &e->ix : index == 2 ? &e->iy : &e->hl;
+    default:
+        g_assert_not_reached();
+    }
+}
+static uint8_t read_reg(CPUEZ80State *e, unsigned reg, bool lm, uintptr_t ra)
+{
+    if (reg == 7) {
+        return e->a;
+    }
+    if (reg == 6) {
+        return cpu_ldub_data_ra(e, address(e, e->hl, lm), ra);
+    }
+    return *pair(e, reg / 2, 0) >> ((reg & 1) ? 0 : 8);
+}
+static void write_reg(CPUEZ80State *e, unsigned reg, uint8_t value,
+                      bool lm, uintptr_t ra)
+{
+    if (reg == 7) {
+        e->a = value;
+    } else if (reg == 6) {
+        cpu_stb_data_ra(e, address(e, e->hl, lm), value, ra);
+    } else {
+        uint32_t *p = pair(e, reg / 2, 0);
+        unsigned shift = (reg & 1) ? 0 : 8;
+        *p = (*p & ~(0xffu << shift)) | ((uint32_t)value << shift);
+    }
+}
+static uint8_t szp(uint8_t value)
+{
+    return (value & FLAG_S) | (value == 0 ? FLAG_Z : 0)
+        | (__builtin_parity((unsigned)value) == 0 ? FLAG_PV : 0);
+}
+static void push(CPUEZ80State *e, uint32_t value, unsigned n, bool lm,
+                 uintptr_t ra)
+{
+    uint32_t sp = lm ? e->spl : e->sps;
+    uint32_t mask = lm ? EZ80_ADDR_MASK : 0xffff;
+    for (unsigned i = n; i != 0; i--) {
+        sp = (sp - 1) & mask;
+        cpu_stb_data_ra(e, address(e, sp, lm), value >> ((i - 1) * 8), ra);
+    }
+    if (lm) {
+        e->spl = sp;
+    } else {
+        e->sps = sp;
+    }
+}
+static uint32_t pop(CPUEZ80State *e, unsigned n, bool lm, uintptr_t ra)
+{
+    uint32_t sp = lm ? e->spl : e->sps;
+    uint32_t mask = lm ? EZ80_ADDR_MASK : 0xffff, value = 0;
+    for (unsigned i = 0; i < n; i++) {
+        value |= (uint32_t)cpu_ldub_data_ra(e, address(e, sp, lm), ra)
+                 << (i * 8);
+        sp = (sp + 1) & mask;
+    }
+    if (lm) {
+        e->spl = sp;
+    } else {
+        e->sps = sp;
+    }
+    return value;
+}
+void helper_illegal(CPUEZ80State *e, uint32_t pc, uint32_t mode)
+{
+    uintptr_t ra = GETPC();
+    /* TRAP stacks the address of the illegal opcode byte. With MADL,
+     * enter the ADL supervisor on SPL, using RET.L markers 02h/03h.
+     * Without MADL the current memory mode/stack is retained. IFF is unchanged.
+     */
+    push(e, pc, e->adl ? 3 : 2, e->adl || e->madl, ra);
+    if (e->madl) {
+        push(e, e->adl ? 3 : 2, 1, true, ra);
+        e->adl = 1;
+    }
+    e->r = (e->r & 0x80) | ((e->r + (mode >> EZ80_R_SHIFT)) & 0x7f);
+    if (e->ei_delay) {
+        e->ei_delay--;
+    }
+    e->pc = address(e, 0, e->adl);
+}
+static bool condition_code(CPUEZ80State *e, unsigned cc)
+{
+    switch (cc) {
+    case 0:
+        return !(e->f & FLAG_Z);
+    case 1:
+        return e->f & FLAG_Z;
+    case 2:
+        return !(e->f & FLAG_C);
+    case 3:
+        return e->f & FLAG_C;
+    case 4:
+        return !(e->f & FLAG_PV);
+    case 5:
+        return e->f & FLAG_PV;
+    case 6:
+        return !(e->f & FLAG_S);
+    case 7:
+        return e->f & FLAG_S;
+    default:
+        g_assert_not_reached();
+    }
+}
+static bool condition(CPUEZ80State *e, unsigned op)
+{
+    switch (op) {
+    case 0x20:
+        return !(e->f & FLAG_Z);
+    case 0x28:
+        return e->f & FLAG_Z;
+    case 0x30:
+        return !(e->f & FLAG_C);
+    case 0x38:
+        return e->f & FLAG_C;
+    default:
+        return true;
+    }
+}
+static void mixed_return(CPUEZ80State *e, uintptr_t ra)
+{
+    bool from_long = e->adl;
+    unsigned marker = pop(e, 1, true, ra);
+    uint32_t value;
+    if (marker != 2 && marker != 3) {
+        error_report("eZ80F91: invalid mixed return marker %02x", marker);
+        exit(EXIT_FAILURE);
+    }
+    if (from_long) {
+        value = pop(e, marker == 3 ? 3 : 2, true, ra);
+    } else {
+        value = marker == 3 ? pop(e, 1, true, ra) << 16 : 0;
+        value |= pop(e, 2, false, ra);
+    }
+    e->adl = marker == 3;
+    e->pc = address(e, value, e->adl);
+}
+
+static uint32_t load_multi(CPUEZ80State *e, uint32_t addr, unsigned width,
+                            bool lm, uintptr_t ra)
+{
+    uint32_t value = 0;
+    for (unsigned i = 0; i < width; i++) {
+        value |= (uint32_t)cpu_ldub_data_ra(e, address(e, addr + i, lm), ra)
+                 << (8 * i);
+    }
+    return value;
+}
+static void store_multi(CPUEZ80State *e, uint32_t addr, uint32_t value,
+                        unsigned width, bool lm, uintptr_t ra)
+{
+    for (unsigned i = 0; i < width; i++) {
+        cpu_stb_data_ra(e, address(e, addr + i, lm), value >> (8 * i), ra);
+    }
+}
+static uint32_t add_sub(CPUEZ80State *e, uint32_t a, uint32_t b,
+                        unsigned carry, bool sub, bool lm, bool full_flags)
+{
+    uint32_t mask = lm ? 0xffffff : 0xffff;
+    uint32_t sign = lm ? 0x800000 : 0x8000;
+    uint32_t wide = sub ? a - b - carry : a + b + carry;
+    uint32_t result = wide & mask;
+    uint8_t flags = (((a ^ b ^ result) & 0x1000) ? FLAG_H : 0)
+                  | ((wide & ~mask) ? FLAG_C : 0) | (sub ? FLAG_N : 0);
+    if (full_flags) {
+        flags |= (result & sign ? FLAG_S : 0) | (!result ? FLAG_Z : 0);
+        if ((sub ? (a ^ b) & (a ^ result) : ~(a ^ b) & (a ^ result)) & sign) {
+            flags |= FLAG_PV;
+        }
+    } else {
+        flags |= e->f & (FLAG_S | FLAG_Z | FLAG_PV);
+    }
+    e->f = flags;
+    return result;
+}
+static void alu8(CPUEZ80State *e, unsigned operation, uint8_t b)
+{
+    unsigned a = e->a, carry = (operation & 1) ? !!(e->f & FLAG_C) : 0;
+    unsigned wide;
+    uint8_t result;
+    bool sub = operation == 2 || operation == 3 || operation == 7;
+    if (operation < 4 || operation == 7) {
+        if (operation == 7) {
+            carry = 0;
+        }
+        wide = sub ? a - b - carry : a + b + carry;
+        result = wide;
+        e->f = (result & FLAG_S) | (!result ? FLAG_Z : 0)
+             | (((a ^ b ^ result) & 0x10) ? FLAG_H : 0)
+             | ((wide & ~0xffu) ? FLAG_C : 0) | (sub ? FLAG_N : 0)
+             | (((sub ? (a ^ b) & (a ^ result)
+                      : ~(a ^ b) & (a ^ result)) & 0x80) ? FLAG_PV : 0);
+        if (operation != 7) {
+            e->a = result;
+        }
+    } else {
+        e->a = operation == 4 ? a & b : operation == 5 ? a ^ b : a | b;
+        e->f = szp(e->a) | (operation == 4 ? FLAG_H : 0);
+    }
+}
+
+void ez80_cpu_take_interrupt(CPUEZ80State *e)
+{
+    bool long_handler = e->adl || e->madl;
+    uint32_t vector = e->irq_vector;
+    uint32_t table = long_handler ? ((e->i & 0xfffeu) << 8) | vector
+                     : (e->mbase << 16) | ((e->i & 0xfeu) << 8) | vector;
+    uint32_t target = load_multi(e, table, long_handler ? 3 : 2,
+                                 long_handler, 0);
+    e->iff1 = e->iff2 = e->ei_delay = 0;
+    if (e->madl) {
+        push(e, e->pc, e->adl ? 3 : 2, true, 0);
+        push(e, e->adl, 1, true, 0); /* F91 interrupt marker: 0/1. */
+        e->adl = 1;
+    } else {
+        push(e, e->pc, e->adl ? 3 : 2, e->adl, 0);
+    }
+    e->pc = address(e, target, long_handler);
+}
+
+static uint8_t inc_dec8(CPUEZ80State *e, uint8_t old, bool sub)
+{
+    uint8_t result = old + (sub ? -1 : 1);
+    e->f = (e->f & FLAG_C) | (result & FLAG_S)
+         | (!result ? FLAG_Z : 0) | (sub ? FLAG_N : 0)
+         | (((old ^ result ^ 1) & 0x10) ? FLAG_H : 0)
+         | (old == (sub ? 0x80 : 0x7f) ? FLAG_PV : 0);
+    return result;
+}
+static uint8_t read_index_byte(CPUEZ80State *e, unsigned reg, unsigned index,
+                                uintptr_t ra)
+{
+    if (reg == 4 || reg == 5) {
+        return *pair(e, 2, index) >> (reg == 4 ? 8 : 0);
+    }
+    return read_reg(e, reg, true, ra);
+}
+static void write_index_byte(CPUEZ80State *e, unsigned reg, unsigned index,
+                              uint8_t value, uintptr_t ra)
+{
+    if (reg == 4 || reg == 5) {
+        uint32_t *p = pair(e, 2, index);
+        unsigned shift = reg == 4 ? 8 : 0;
+        *p = (*p & ~(0xffu << shift)) | ((uint32_t)value << shift);
+    } else {
+        write_reg(e, reg, value, true, ra);
+    }
+}
+static void block_io(CPUEZ80State *e, unsigned op, bool lm,
+                     uint32_t pc, uintptr_t ra)
+{
+    bool two = (op & 0xc7) == 0x84;
+    bool wide_count = (two && (op & 0x10)) || (op & 0xf6) == 0xc2;
+    bool moving_port = (op & 0xe6) == 0x82 || two;
+    bool repeat = wide_count || (op & 0x10);
+    bool output = two ? !!(op & 0x20) : !!(op & 1);
+    int delta = (op & 8) ? -1 : 1;
+    uint32_t mask = lm ? EZ80_ADDR_MASK : 0xffff;
+    uint32_t port = wide_count ? e->de : e->bc;
+    uint32_t count;
+    uint8_t byte;
+
+    port &= (op & 0xe6) == 0x82 ? 0xff : 0xffff;
+    if (output) {
+        byte = cpu_ldub_data_ra(e, address(e, e->hl, lm), ra);
+        address_space_stb(&address_space_io, port, byte,
+                          MEMTXATTRS_UNSPECIFIED, NULL);
+    } else {
+        byte = address_space_ldub(&address_space_io, port,
+                                   MEMTXATTRS_UNSPECIFIED, NULL);
+        cpu_stb_data_ra(e, address(e, e->hl, lm), byte, ra);
+    }
+    e->hl = (e->hl + delta) & mask;
+    if (wide_count) {
+        count = e->bc = (e->bc - 1) & mask;
+        if (moving_port) {
+            e->de = (e->de + delta) & mask;
+        }
+    } else {
+        uint8_t b = (e->bc >> 8) - 1;
+        uint8_t c = e->bc + (moving_port ? delta : 0);
+        e->bc = (e->bc & 0xff0000) | (b << 8) | c;
+        count = b;
+    }
+    /*
+     * UM0077: eZ80 preserves S/H/PV/C for the defined block-I/O variants.
+     * Preserve them deterministically for variants marking them undefined.
+     */
+    e->f = (e->f & ~(FLAG_Z | FLAG_N)) | (!count ? FLAG_Z : 0)
+         | (byte & 0x80 ? FLAG_N : 0);
+    if (repeat && count) {
+        e->pc = pc;
+    }
+}
+
+/* Decoded instruction side effects; no instruction dispatch loop. */
+static void execute(CPUEZ80State *e, uint32_t op, uint32_t arg,
+                    uint32_t mode, uint32_t next_pc, uintptr_t ra)
+{
+    bool lm = mode & EZ80_MLONG, il = mode & EZ80_ILONG;
+    bool prefixed = mode & EZ80_PREFIX;
+    unsigned index = (mode >> EZ80_INDEX_SHIFT) & 3;
+    uint32_t mask = lm ? EZ80_ADDR_MASK : 0xffff;
+    unsigned width = lm ? 3 : 2;
+    uint32_t value, *p;
+    uint32_t pc = e->pc;
+
+    if (e->ei_delay) {
+        e->ei_delay--;
+    }
+    e->pc = next_pc;
+    e->r = (e->r & 0x80) | ((e->r + (mode >> EZ80_R_SHIFT)) & 0x7f);
+    if (mode & EZ80_CB) {
+        unsigned bit = (op >> 3) & 7;
+        uint32_t addr = index ? (*pair(e, 2, index) + (int8_t)arg) & mask
+                              : e->hl;
+        value = index ? cpu_ldub_data_ra(e, address(e, addr, lm), ra)
+                      : read_reg(e, op & 7, lm, ra);
+        if (op < 0x40) {
+            unsigned carry = (bit & 1) ? value & 1 : value >> 7;
+            unsigned incoming = (bit < 2) ? carry : !!(e->f & FLAG_C);
+            switch (bit) {
+            case 0:
+            case 2:
+                value = (value << 1) | incoming;
+                break;
+            case 1:
+            case 3:
+                value = (value >> 1) | (incoming << 7);
+                break;
+            case 4:
+                value <<= 1;
+                break;
+            case 5:
+                value = (value >> 1) | (value & 0x80);
+                break;
+            case 7:
+                value >>= 1;
+                break;
+            default:
+                g_assert_not_reached();
+            }
+            value &= 0xff;
+            e->f = szp(value) | carry;
+        } else if (op < 0x80) {
+            bool zero = !(value & (1u << bit));
+            e->f = (e->f & FLAG_C) | FLAG_H | (zero ? FLAG_Z | FLAG_PV : 0)
+                 | (bit == 7 && !zero ? FLAG_S : 0);
+            return;
+        } else {
+            value = op < 0xc0 ? value & ~(1u << bit) : value | (1u << bit);
+        }
+        if (index) {
+            cpu_stb_data_ra(e, address(e, addr, lm), value, ra);
