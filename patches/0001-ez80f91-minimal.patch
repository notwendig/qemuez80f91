+        } else {
+            if (!e->madl) {
+                helper_unsupported(e, pc, op);
+            }
+            if (lm) {
+                push(e, next_pc, e->adl ? 3 : 2, true, ra);
+            } else {
+                push(e, next_pc, 2, false, ra);
+                if (e->adl) {
+                    push(e, next_pc >> 16, 1, true, ra);
+                }
+            }
+            push(e, e->adl ? 3 : 2, 1, true, ra);
+        }
+        e->adl = lm;
+        e->pc = address(e, op & 0x38, lm);
+    } else if (op == 0xcd || (op & 0xc7) == 0xc4) {
+        if (op != 0xcd && !condition_code(e, (op >> 3) & 7)) {
+            return;
+        }
+        if (!prefixed) {
+            push(e, next_pc, width, lm, ra);
+        } else {
+            if (!e->madl) {
+                helper_unsupported(e, pc, op);
+            }
+            if (il) {
+                push(e, next_pc, e->adl ? 3 : 2, true, ra);
+            } else {
+                push(e, next_pc, 2, false, ra);
+                if (e->adl) {
+                    push(e, next_pc >> 16, 1, true, ra);
+                }
+            }
+            push(e, e->adl ? 3 : 2, 1, true, ra);
+        }
+        e->adl = il;
+        e->pc = address(e, arg, il);
+    } else if (op == 0xc9 || (op & 0xc7) == 0xc0) {
+        if (op != 0xc9 && !condition_code(e, (op >> 3) & 7)) {
+            return;
+        }
+        if (prefixed) {
+            if (!e->madl) {
+                helper_unsupported(e, pc, op);
+            }
+            mixed_return(e, ra);
+        } else {
+            e->pc = address(e, pop(e, width, lm, ra), lm);
+        }
+    } else if (op == 0x18 || op == 0x20 || op == 0x28
+               || op == 0x30 || op == 0x38) {
+        if (condition(e, op)) {
+            e->pc = address(e, next_pc + (int8_t)arg, e->adl);
+        }
+    } else if (op == 0x32 || op == 0x3a || op == 0x22 || op == 0x2a) {
+        uint32_t addr = address(e, arg, lm);
+        unsigned n = (op == 0x32 || op == 0x3a) ? 1 : width;
+        value = op == 0x32 ? e->a : *pair(e, 2, index);
+        if (op == 0x32 || op == 0x22) {
+            for (unsigned i = 0; i < n; i++) {
+                cpu_stb_data_ra(e, address(e, addr + i, lm),
+                                value >> (8 * i), ra);
+            }
+        } else {
+            value = 0;
+            for (unsigned i = 0; i < n; i++) {
+                value |= (uint32_t)cpu_ldub_data_ra(e,
+                    address(e, addr + i, lm), ra) << (8 * i);
+            }
+            if (op == 0x3a) {
+                e->a = value;
+            } else {
+                *pair(e, 2, index) = value;
+            }
+        }
+    } else if (op == 0xc6 || op == 0xce || op == 0xd6 || op == 0xde) {
+        alu8(e, (op >> 3) & 7, arg);
+    } else if (op == 0xe6 || op == 0xf6 || op == 0xee
+               || op == 0xaf || op == 0xb7) {
+        if (op == 0xe6) {
+            e->a &= arg;
+        } else if (op == 0xf6) {
+            e->a |= arg;
+        } else if (op == 0xee) {
+            e->a ^= arg;
+        } else if (op == 0xaf) {
+            e->a = 0;
+        }
+        e->f = szp(e->a) | (op == 0xe6 ? FLAG_H : 0);
+    } else if (op == 0xfe) {
+        uint8_t result = e->a - arg;
+        e->f = (result & FLAG_S) | (result == 0 ? FLAG_Z : 0) | FLAG_N
+            | (e->a < arg ? FLAG_C : 0)
+            | ((e->a ^ arg ^ result) & FLAG_H)
+            | (((e->a ^ arg) & (e->a ^ result) & 0x80) ? FLAG_PV : 0);
+    } else if (op == 0xdb || op == 0xd3) {
+        uint32_t port = (e->a << 8) | arg;
+        if (op == 0xdb) {
+            e->a = address_space_ldub(&address_space_io, port,
+                                      MEMTXATTRS_UNSPECIFIED, NULL);
+        } else {
+            address_space_stb(&address_space_io, port, e->a,
+                              MEMTXATTRS_UNSPECIFIED, NULL);
+        }
+    } else if (op == 0xf3 || op == 0xfb) {
+        e->iff1 = e->iff2 = op == 0xfb;
+        e->ei_delay = op == 0xfb;
+    }
+}
+
+void helper_execute(CPUEZ80State *e, uint32_t op, uint32_t arg,
+                    uint32_t mode, uint32_t next_pc)
+{
+    execute(e, op, arg, mode, next_pc, GETPC());
+}
+typedef struct BoundaryFetch {
+    CPUEZ80State *env;
+    uintptr_t ra;
+} BoundaryFetch;
+static uint8_t boundary_read(void *opaque, uint32_t address)
+{
+    BoundaryFetch *fetch = opaque;
+    return cpu_ldb_code_mmu(fetch->env, address, make_memop_idx(MO_UB, 0),
+                            fetch->ra);
+}
+void helper_boundary(CPUEZ80State *e)
+{
+    BoundaryFetch fetch = { .env = e, .ra = GETPC() };
+    EZ80Decode insn = {
+        .read = boundary_read, .opaque = &fetch,
+        .cursor = e->pc, .adl = e->adl,
+    };
+    ez80_decode(&insn);
+    if (!insn.valid) {
+        helper_illegal(e, ez80_illegal_pc(&insn), insn.mode);
+        return;
+    }
+    execute(e, insn.op, insn.arg, insn.mode, insn.cursor, GETPC());
+    if (ez80_halt(insn.op, insn.mode)) {
+        helper_halt(e);
+    }
+}
