+                if (lm) {
+                    e->spl = value;
+                } else {
+                    e->sps = value;
+                }
+            } else {
+                *pair(e, reg, 0) = value;
+            }
+        } else if (op == 0x31 || op == 0x37 || op == 0x3e || op == 0x3f) {
