+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/error-report.h"
+#include "qemu/units.h"
+#include "hw/core/boards.h"
+#include "hw/core/loader.h"
+#include "system/reset.h"
+#include "cpu.h"
+#include "net/net.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "system/system.h"
+#include "hw/core/qdev-clock.h"
+
+#define TYPE_EZ80F91_MACHINE MACHINE_TYPE_NAME("ez80f91-minimal")
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91MachineState, EZ80F91_MACHINE)
+
+struct EZ80F91MachineState {
+    MachineState parent_obj;
+    bool ram_boot;
+    uint32_t oscillator;
+    char *cs_kind[4];
+    char *cs3_file;
+};
+static void common_init(MachineState *machine, bool evb)
+{
+    EZ80F91MachineState *s = EZ80F91_MACHINE(machine);
+    DeviceState *memory, *uart, *intc, *timer, *clock, *emac, *rtc;
+    CPUState *cpu;
+    const char *image = machine->firmware;
+    uint64_t image_limit = 256 * KiB;
+
+    if (machine->kernel_filename) {
+        if (!evb || !s->ram_boot || machine->firmware) {
+            error_report("-kernel requires ez80f91-freertos,ram-boot=on "
+                         "and no -bios");
+            exit(EXIT_FAILURE);
+        }
+        image = machine->kernel_filename;
+        image_limit = 512 * KiB;
+    } else if (s->ram_boot) {
+        error_report("ram-boot=on requires a raw image via -kernel");
+        exit(EXIT_FAILURE);
+    }
+    memory = qdev_new("ez80f91-memory");
+    for (unsigned cs = 0; cs < 4; cs++) {
+        g_autofree char *name = g_strdup_printf("cs%u", cs);
+        qdev_prop_set_string(memory, name, s->cs_kind[cs]);
+    }
+    if (s->cs3_file) {
+        qdev_prop_set_string(memory, "cs3-file", s->cs3_file);
+    }
+    qdev_prop_set_bit(memory, "evb", evb);
+    qdev_prop_set_bit(memory, "ram-boot", s->ram_boot);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(memory), &error_fatal);
+    device_cold_reset(memory);
+    if (image && load_image_targphys(image, 0, image_limit, &error_fatal) < 0) {
+        exit(EXIT_FAILURE);
+    }
+    cpu = cpu_create(machine->cpu_type);
+    qemu_register_resettable(OBJECT(cpu));
+    intc = qdev_new("ez80f91-intc");
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(intc), &error_fatal);
+    for (unsigned line = 0; line < 10; line++) {
+        qdev_connect_gpio_out(intc, line, qdev_get_gpio_in(DEVICE(cpu), line));
+    }
+    sysbus_connect_irq(SYS_BUS_DEVICE(memory), 0, qdev_get_gpio_in(intc, 4));
+    for (unsigned bit = 0; bit < 3; bit++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(memory), bit + 1,
+                           qdev_get_gpio_in(intc, 24 + bit));
+    }
+    clock = qdev_new("ez80f91-clock");
+    qdev_prop_set_uint32(clock, "osc-frequency", s->oscillator);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(clock), &error_fatal);
+    sysbus_connect_irq(SYS_BUS_DEVICE(clock), 0, qdev_get_gpio_in(intc, 3));
+    device_cold_reset(clock);
+    rtc = qdev_new("ez80f91-rtc");
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(rtc), &error_fatal);
+    device_cold_reset(rtc);
+    uart = qdev_new("ez80f91-uart");
+    qdev_prop_set_chr(uart, "chardev", serial_hd(0));
+    qdev_connect_clock_in(uart, "sclk", qdev_get_clock_out(clock, "sclk"));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(uart), &error_fatal);
+    sysbus_connect_irq(SYS_BUS_DEVICE(uart), 0, qdev_get_gpio_in(intc, 12));
+    timer = qdev_new("ez80f91-timer0");
+    qdev_connect_clock_in(timer, "sclk", qdev_get_clock_out(clock, "sclk"));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(timer), &error_fatal);
+    sysbus_connect_irq(SYS_BUS_DEVICE(timer), 0, qdev_get_gpio_in(intc, 5));
+    sysbus_connect_irq(SYS_BUS_DEVICE(timer), 1, qdev_get_gpio_in(intc, 6));
+    emac = qdev_new("ez80f91-emac");
+    object_property_set_link(OBJECT(emac), "memory", OBJECT(memory),
+                             &error_abort);
+    qdev_connect_clock_in(emac, "sclk", qdev_get_clock_out(clock, "sclk"));
+    qemu_configure_nic_device(emac, true, NULL);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(emac), &error_fatal);
+    for (unsigned line = 0; line < 3; line++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(emac), line,
+                           qdev_get_gpio_in(intc, line));
+    }
+}
+static void minimal_init(MachineState *machine)
+{
+    common_init(machine, false);
+}
+static void evb_init(MachineState *machine)
+{
+    common_init(machine, true);
+}
+static bool get_ram_boot(Object *obj, Error **errp)
+{
+    return EZ80F91_MACHINE(obj)->ram_boot;
+}
+static void set_ram_boot(Object *obj, bool value, Error **errp)
+{
+    EZ80F91_MACHINE(obj)->ram_boot = value;
+}
+static void machine_instance_init(Object *obj)
+{
+    EZ80F91MachineState *s = EZ80F91_MACHINE(obj);
+    s->oscillator = 50000000;
+    for (unsigned cs = 0; cs < 4; cs++) {
+        s->cs_kind[cs] = g_strdup(cs ? "ram" : "flash");
+    }
+}
+static void get_oscillator(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &EZ80F91_MACHINE(obj)->oscillator, errp);
+}
+static void set_oscillator(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_uint32(v, name, &EZ80F91_MACHINE(obj)->oscillator, errp);
+}
+static void get_cs_kind(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    EZ80F91MachineState *s = EZ80F91_MACHINE(obj);
+
+    visit_type_str(v, name, &s->cs_kind[name[2] - '0'], errp);
+}
+static void set_cs_kind(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    char *kind = NULL;
+    unsigned cs = name[2] - '0';
+
+    if (phase_check(PHASE_MACHINE_INITIALIZED)) {
+        error_setg(errp, "%s is a startup-only board setting", name);
+        return;
+    }
+    if (!visit_type_str(v, name, &kind, errp)) {
+        return;
+    }
+    if (strcmp(kind, "ram") && strcmp(kind, "flash") && strcmp(kind, "none")) {
+        error_setg(errp, "%s must be ram, flash or none", name);
+        g_free(kind);
+        return;
+    }
+    g_free(EZ80F91_MACHINE(obj)->cs_kind[cs]);
+    EZ80F91_MACHINE(obj)->cs_kind[cs] = kind;
+}
+static void get_cs3_file(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    visit_type_str(v, name, &EZ80F91_MACHINE(obj)->cs3_file, errp);
+}
+static void set_cs3_file(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    char *path = NULL;
+    if (phase_check(PHASE_MACHINE_INITIALIZED)) {
+        error_setg(errp, "cs3-file is a startup-only board setting");
+        return;
+    }
+    if (visit_type_str(v, name, &path, errp)) {
+        g_free(EZ80F91_MACHINE(obj)->cs3_file);
+        EZ80F91_MACHINE(obj)->cs3_file = path;
+    }
+}
+static void machine_finalize(Object *obj)
+{
+    g_free(EZ80F91_MACHINE(obj)->cs3_file);
+    for (unsigned cs = 0; cs < 4; cs++) {
+        g_free(EZ80F91_MACHINE(obj)->cs_kind[cs]);
+    }
+}
+static void ez80f91_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    static const char * const valid_cpu_types[] = {
+        EZ80_CPU_TYPE_NAME("ez80f91"), NULL
+    };
+    object_class_property_add(oc, "osc-frequency", "uint32",
+                              get_oscillator, set_oscillator, NULL, NULL);
+    object_class_property_set_description(oc, "osc-frequency",
+                                         "External oscillator frequency in Hz");
+    for (unsigned cs = 0; cs < 4; cs++) {
+        g_autofree char *name = g_strdup_printf("cs%u", cs);
+        object_class_property_add(oc, name, "str", get_cs_kind, set_cs_kind,
+                                  NULL, NULL);
+        object_class_property_set_description(oc, name,
+            "External device on this chip select: ram, flash or none");
+
+    }
+    object_class_property_add(oc, "cs3-file", "str", get_cs3_file,
+                              set_cs3_file, NULL, NULL);
+    object_class_property_set_description(oc, "cs3-file",
+        "Raw writable CS3 RAM image, saved on orderly exit");
+    mc->desc = "eZ80F91 minimal development machine (experimental)";
+    mc->init = minimal_init;
+    mc->default_cpu_type = EZ80_CPU_TYPE_NAME("ez80f91");
+    mc->valid_cpu_types = valid_cpu_types;
+    mc->default_cpus = mc->min_cpus = mc->max_cpus = 1;
+    mc->no_floppy = mc->no_cdrom = mc->no_parallel = 1;
+}
+static void evb_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "eZ80F91 FreeRTOS RAM development profile (experimental)";
+    mc->init = evb_init;
+    object_class_property_add_bool(oc, "ram-boot", get_ram_boot, set_ram_boot);
+    object_class_property_set_description(oc, "ram-boot",
+        "Apply the ZDS RAM-debug memory setup on reset (not silicon defaults)");
+}
+static const TypeInfo machine_types[] = {
+    {
+        .name = TYPE_EZ80F91_MACHINE,
+        .parent = TYPE_MACHINE,
+        .instance_size = sizeof(EZ80F91MachineState),
+        .instance_init = machine_instance_init,
+        .instance_finalize = machine_finalize,
+        .class_init = ez80f91_class_init,
+    }, {
+        .name = MACHINE_TYPE_NAME("ez80f91-freertos"),
+        .parent = TYPE_EZ80F91_MACHINE,
+        .class_init = evb_class_init,
+    },
+};
+DEFINE_TYPES(machine_types)
diff --git a/hw/ez80/intc.c b/hw/ez80/intc.c
new file mode 100644
index 0000000..83b4fbf
--- /dev/null
+++ b/hw/ez80/intc.c
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qemu/host-utils.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "system/address-spaces.h"
+
+#define TYPE_EZ80F91_INTC "ez80f91-intc"
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91IntcState, EZ80F91_INTC)
+
+struct EZ80F91IntcState {
+    SysBusDevice parent_obj;
+    MemoryRegion ports;
+    qemu_irq outputs[10]; /* IRQ followed by the nine vector bus bits. */
+    uint64_t pending, high_priority;
+};
+static void update_irq(EZ80F91IntcState *s)
+{
+    uint64_t high = s->pending & s->high_priority;
+    uint64_t active = high ? high : s->pending;
+    unsigned vector = active ? 0x40 + 4 * ctz64(active) : 0;
+    for (unsigned bit = 0; bit < 9; bit++) {
+        qemu_set_irq(s->outputs[bit + 1], (vector >> bit) & 1);
+    }
+    qemu_set_irq(s->outputs[0], active != 0);
+}
+static void set_input(void *opaque, int source, int level)
+{
+    EZ80F91IntcState *s = opaque;
+    if (source == 9 || source == 10) {
+        return;
+    }
+    if (level) {
+        s->pending |= 1ull << source;
+    } else {
+        s->pending &= ~(1ull << source);
+    }
+    update_irq(s);
+}
+static uint64_t priority_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return EZ80F91_INTC(opaque)->high_priority >> (addr * 8) & 0xff;
+}
+static void priority_write(void *opaque, hwaddr addr, uint64_t value,
+                           unsigned size)
+{
+    EZ80F91IntcState *s = opaque;
+    uint64_t mask = 0xffull << (addr * 8);
+    if (addr == 1) {
+        value &= ~6u; /* Unused vectors 064h and 068h. */
+    }
+    s->high_priority = (s->high_priority & ~mask) | (value << (addr * 8));
+    update_irq(s);
+}
+static const MemoryRegionOps priority_ops = {
+    .read = priority_read,
+    .write = priority_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static void intc_reset(Object *obj, ResetType type)
+{
+    EZ80F91IntcState *s = EZ80F91_INTC(obj);
+    s->pending = s->high_priority = 0;
+    update_irq(s);
+}
+static void intc_init(Object *obj)
+{
+    EZ80F91IntcState *s = EZ80F91_INTC(obj);
+    qdev_init_gpio_in(DEVICE(s), set_input, 48);
+    qdev_init_gpio_out(DEVICE(s), s->outputs, 10);
+    memory_region_init_io(&s->ports, obj, &priority_ops, s,
+                          "f91.int-priority", 6);
+    memory_region_add_subregion(get_system_io(), 0x10, &s->ports);
+}
+static void intc_class_init(ObjectClass *oc, const void *data)
+{
+    RESETTABLE_CLASS(oc)->phases.hold = intc_reset;
+    DEVICE_CLASS(oc)->user_creatable = false;
+}
+static const TypeInfo intc_type = {
+    .name = TYPE_EZ80F91_INTC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(EZ80F91IntcState),
+    .instance_init = intc_init,
+    .class_init = intc_class_init,
+};
+static void intc_register_types(void)
+{
+    type_register_static(&intc_type);
+}
+type_init(intc_register_types);
diff --git a/hw/ez80/memory.c b/hw/ez80/memory.c
new file mode 100644
index 0000000000..86a429fcbbaf3d67d66dc301511714ae83cedc5a
--- /dev/null
+++ b/hw/ez80/memory.c
@@ -0,0 +1,854 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Functional F91 memory decoding and Flash information-page I/O. */
+#include "qemu/osdep.h"
+#include "hw/ez80/ez80f91.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "hw/core/irq.h"
+#include "hw/block/flash.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+#include "qemu/crc32.h"
+
+#define TYPE_EZ80F91_MEMORY "ez80f91-memory"
+OBJECT_DECLARE_SIMPLE_TYPE(EZ80F91MemoryState, EZ80F91_MEMORY)
+
+struct EZ80F91MemoryState {
+    SysBusDevice parent_obj;
+    MemoryRegion flash, ram, eram;
+    MemoryRegion bank[4], window[4];
+    char *cs_kind[4];
+    char *cs3_file;
+    size_t cs3_file_size;
+    unsigned flash_base[4];
+    MemoryRegion *external_flash[4];
+    MemoryRegion cs_ports, ram_ports, flash_ports, bus_ports;
+    uint8_t cs[4][3], bmc[4];
+    uint8_t ram_ctl, ram_upper, flash_ctl, flash_upper;
+    uint8_t flash_io[11], info[512], key_stage;
+    bool flash_unlocked;
+    qemu_irq flash_irq;
+    bool evb, ram_boot;
+    MemoryRegion *persistent[5];
+    char *flash_file[5];
+    Notifier flash_exit;
+    MemoryRegion kit_ports, pb_ports, pb_ack_port;
+    qemu_irq button_irq[3];
+    uint8_t kit_buttons, pb[4], pb_pending;
+    char *kit_led_file;
+    QEMUTimer *kit_timer;
+    uint8_t kit_latch[3];
+    uint64_t kit_energy[35], kit_row_time[7], kit_current, kit_mask;
+    int64_t kit_last_ns, kit_frame_ns, kit_static_ns;
+    bool kit_enabled;
+
+};
+
+static void external_flash_activate(EZ80F91MemoryState *s, unsigned cs);
+
+/* Kit SW1..3 pull PB0..2 low. Implement GPIO input/output and the
+ * dual-edge interrupt mode used by the board's button driver. */
+static uint8_t button_irq_mask(EZ80F91MemoryState *s)
+{
+    return s->pb[0] & ~s->pb[1] & ~s->pb[2] & s->pb[3] & 7;
+}
+static void button_irq_update(EZ80F91MemoryState *s)
+{
+    for (unsigned bit = 0; bit < 3; bit++) {
+        qemu_set_irq(s->button_irq[bit],
+                     !!(s->pb_pending & button_irq_mask(s) & (1 << bit)));
+    }
+}
+static uint64_t pb_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    if (addr == 0) {
+        uint8_t inputs = s->pb[1] | s->pb[3];
+        return (s->pb[0] & ~inputs) | ((uint8_t)~s->kit_buttons & inputs);
+    }
+    return s->pb[addr];
+}
+static void pb_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    s->pb[addr] = value;
+    s->pb_pending &= button_irq_mask(s);
+    button_irq_update(s);
+}
+static uint64_t pb_ack_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return 0; /* Px_ALT0 is a write-one-to-clear command register. */
+}
+static void pb_ack_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    s->pb_pending &= ~value;
+    button_irq_update(s);
+}
+static void buttons_get(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    visit_type_uint8(v, name, &EZ80F91_MEMORY(obj)->kit_buttons, errp);
+}
+static void buttons_set(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    EZ80F91MemoryState *s = EZ80F91_MEMORY(obj);
+    uint8_t pressed;
+    if (!visit_type_uint8(v, name, &pressed, errp)) {
+        return;
+    }
+    if (pressed & ~7u) {
+        error_setg(errp, "kit-buttons must be a mask in 0..7");
+        return;
+    }
+    s->pb_pending |= (s->kit_buttons ^ pressed) & button_irq_mask(s);
+    s->kit_buttons = pressed;
+    button_irq_update(s);
+}
+static void kit_accumulate(EZ80F91MemoryState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t elapsed = MAX(0, now - s->kit_last_ns);
+    for (unsigned i = 0; i < 35; i++) {
+        if (s->kit_current & (1ULL << i)) {
+            s->kit_energy[i] += elapsed;
+        }
+    }
+    for (unsigned row = 0; row < 7; row++) {
+        if (s->kit_enabled && (s->kit_latch[0] & (1 << row))) {
+            s->kit_row_time[row] += elapsed;
+        }
+    }
+    s->kit_last_ns = now;
+}
+static void kit_clear_energy(EZ80F91MemoryState *s)
+{
+    memset(s->kit_energy, 0, sizeof(s->kit_energy));
+    memset(s->kit_row_time, 0, sizeof(s->kit_row_time));
+    s->kit_frame_ns = s->kit_last_ns;
+}
+static void kit_complete_scan(EZ80F91MemoryState *s)
+{
+    uint64_t elapsed = s->kit_last_ns - s->kit_frame_ns;
+    uint64_t mask = 0;
+
+    for (unsigned row = 0; row < 7; row++) {
+        if (!s->kit_row_time[row]) {
+            return;
+        }
+    }
+    for (unsigned i = 0; i < 35; i++) {
+        if (s->kit_energy[i] && s->kit_energy[i] >= elapsed / 100) {
+            mask |= 1ULL << i;
+        }
+    }
+    /* Animation may change on every scan; never require repeated images. */
+    s->kit_mask = mask;
+    kit_clear_energy(s);
+}
+static void kit_pixels(EZ80F91MemoryState *s)
+{
+    s->kit_current = 0;
+    if (s->kit_enabled) {
+        for (unsigned row = 0; row < 7; row++) {
+            for (unsigned col = 0; col < 5; col++) {
+                if ((s->kit_latch[0] & (1 << row)) &&
+                    !(s->kit_latch[1] & (1 << (4 - col)))) {
+                    s->kit_current |= 1ULL << (row * 5 + col);
+                }
+            }
+        }
+    }
+}
+static void kit_publish(void *opaque)
+{
+    EZ80F91MemoryState *s = opaque;
+    uint64_t mask = 0;
+    uint8_t rows;
+    g_autofree char *json = NULL;
+    g_autoptr(GError) error = NULL;
+    kit_accumulate(s);
+    /* The real-time GUI poll never publishes a partial multiplex scan.
+     * kit_write commits only after all seven rows have finished their dwell.
+     */
+    mask = s->kit_mask;
+    rows = s->kit_latch[0] & 0x7f;
+    if (!s->kit_enabled) {
+        mask = 0;
+        kit_clear_energy(s);
+    } else if (!s->kit_last_ns) {
+        /* Static debugger probes before the guest starts are not row scans. */
+        mask = s->kit_current;
+    } else if ((!rows || (rows & (rows - 1))) &&
+               s->kit_last_ns - s->kit_static_ns >= 40 * 1000 * 1000) {
+        /* A stable blank or parallel drive has no seven-row scan boundary. */
+        mask = s->kit_current;
+        kit_clear_energy(s);
+    }
+    s->kit_mask = mask;
+    json = g_strdup_printf("{\"mask\":\"%09" PRIx64 "\",\"anode\":%u,"
+                           "\"cathode\":%u,\"gpio\":%u,\"buttons\":%u,\"enabled\":%s}\n",
+                           mask, s->kit_latch[0], s->kit_latch[1],
+                           s->kit_latch[2], s->kit_buttons, s->kit_enabled ? "true" : "false");
+    if (!g_file_set_contents(s->kit_led_file, json, -1, &error)) {
+        error_report("Kit LED state: %s", error->message);
+    }
+    timer_mod(s->kit_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20);
+}
+static uint64_t kit_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    /* Anode/cathode latches are write-only. GPIO inputs are pulled high. */
+    return addr == 2 ? (s->kit_latch[0] & 0x80 ? 0xff : s->kit_latch[2]) : 0xff;
+}
+static void kit_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    kit_accumulate(s);
+    if (addr == 0 && ((s->kit_latch[0] ^ value) & 0x7f)) {
+        kit_complete_scan(s);
+        s->kit_static_ns = s->kit_last_ns;
+    }
+    s->kit_latch[addr] = value;
+    kit_pixels(s);
+}
+static const MemoryRegionOps pb_ops = {
+    .read = pb_read, .write = pb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static const MemoryRegionOps pb_ack_ops = {
+    .read = pb_ack_read, .write = pb_ack_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 1 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static const MemoryRegionOps kit_ops = {
+    .read = kit_read, .write = kit_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+static bool kit_selected(EZ80F91MemoryState *s)
+{
+    if (!s->kit_led_file || (s->cs[2][2] & 0x18) != 8 ||
+        s->cs[2][0] > 0x80 || s->cs[2][1] < 0x80) {
+        return false;
+    }
+    for (unsigned cs = 0; cs < 2; cs++) {
+        if ((s->cs[cs][2] & 0x18) == 8 &&
+            s->cs[cs][0] <= 0x80 && s->cs[cs][1] >= 0x80) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void update_window(EZ80F91MemoryState *s, unsigned cs)
+{
+    MemoryRegion *window = &s->window[cs];
+    unsigned lower = s->cs[cs][0], upper = s->cs[cs][1];
+    bool enabled = (s->cs[cs][2] & 0x18) == 8 && upper >= lower;
+
+    memory_region_set_enabled(window, false);
+    if (enabled) {
+        memory_region_set_size(window, (hwaddr)(upper - lower + 1) << 16);
+        memory_region_set_address(window, (hwaddr)lower << 16);
+        memory_region_set_enabled(window, true);
+    }
+}
+static void update_mapping(EZ80F91MemoryState *s)
+{
+    memory_region_transaction_begin();
+    memory_region_set_enabled(&s->flash, !!(s->flash_ctl & 8));
+    memory_region_set_address(&s->flash, (hwaddr)s->flash_upper << 16);
+    memory_region_set_enabled(&s->ram, !!(s->ram_ctl & 0x80));
+    memory_region_set_enabled(&s->eram, !!(s->ram_ctl & 0x40));
+    memory_region_set_address(&s->ram, ((hwaddr)s->ram_upper << 16) | 0xe000);
+    memory_region_set_address(&s->eram, ((hwaddr)s->ram_upper << 16) | 0xc000);
+    for (unsigned cs = 0; cs < 4; cs++) {
+        update_window(s, cs);
+    }
+    kit_accumulate(s);
+    s->kit_enabled = kit_selected(s);
+    memory_region_set_enabled(&s->kit_ports, s->kit_enabled);
+    kit_pixels(s);
+    memory_region_transaction_commit();
+}
+static uint64_t cs_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    return s->cs[addr / 3][addr % 3];
+}
+static void cs_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    s->cs[addr / 3][addr % 3] = addr % 3 == 2 ? val & 0xf8 : val;
+    if (addr % 3 == 2 && (s->cs[addr / 3][2] & 0x18) == 8 &&
+        s->cs[addr / 3][1] >= s->cs[addr / 3][0]) {
+        external_flash_activate(s, addr / 3);
+    }
+    update_mapping(s);
+}
+static uint64_t ram_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    return addr == 0 ? s->ram_ctl : s->ram_upper;
+}
+static void ram_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    if (addr == 0) {
+        s->ram_ctl = val & 0xc0;
+    } else {
+        s->ram_upper = val;
+    }
+    update_mapping(s);
+}
+static void flash_irq_update(EZ80F91MemoryState *s)
+{
+    uint8_t status = s->flash_io[6];
+    qemu_set_irq(s->flash_irq, ((status & 0x80) && (status & 0x20)) ||
+                               ((status & 0x40) && (status & 0x0f)));
+}
+static bool flash_protected(EZ80F91MemoryState *s, unsigned offset)
+{
+    return s->flash_io[5] & (1u << (offset / (32 * KiB)));
+}
+
+static void flash_program(EZ80F91MemoryState *s, unsigned offset, uint8_t value)
+{
+    if (flash_protected(s, offset)) {
+        s->flash_io[6] |= 8;
+    } else {
+        uint8_t *data = memory_region_get_ram_ptr(&s->flash);
+        data[offset] &= value;
+        memory_region_flush_rom_device(&s->flash, offset, 1);
+    }
+    flash_irq_update(s);
+}
+
+static uint64_t flash_array_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    return ((uint8_t *)memory_region_get_ram_ptr(&s->flash))[addr];
+}
+
+static void flash_array_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned size)
+{
+    flash_program(opaque, addr, value);
+}
+
+static const MemoryRegionOps flash_array_ops = {
+    .read = flash_array_read,
+    .write = flash_array_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+
+static void flash_increment(EZ80F91MemoryState *s)
+{
+    if (++s->flash_io[9] == 0) {
+        if (s->flash_io[10] & 4) {
+            s->flash_io[10] &= ~4;
+            s->flash_io[6] |= 0x20;
+        }
+        if (s->flash_io[7] & 0x80) {
+            s->flash_io[8] = (s->flash_io[8] + 1) & 1;
+        } else if (++s->flash_io[8] == 8) {
+            s->flash_io[8] = 0;
+            s->flash_io[7] = (s->flash_io[7] + 1) & 0x7f;
+        }
+    }
+    flash_irq_update(s);
+}
+static uint64_t flash_read(void *opaque, hwaddr addr, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    uint8_t value;
+    switch (addr) {
+    case 0:
+        return 0; /* Write-only key. */
+    case 1:
+        if (s->flash_io[7] & 0x80) {
+            unsigned at = s->flash_io[8] * 256 + s->flash_io[9];
+            value = at < sizeof(s->info) ? s->info[at] : 0xff;
+        } else {
+            uint8_t *flash = memory_region_get_ram_ptr(&s->flash);
+            unsigned at = s->flash_io[7] * 2048 +
+                          s->flash_io[8] * 256 + s->flash_io[9];
+            value = flash[at];
+        }
+        flash_increment(s);
+        return value;
+    case 2:
+        return s->flash_upper;
+    case 3:
+        return s->flash_ctl;
+    case 6:
+        value = s->flash_io[6];
+        s->flash_io[6] &= 0xc0;
+        flash_irq_update(s);
+        return value;
+    default:
+        return s->flash_io[addr];
+    }
+}
+static void flash_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    EZ80F91MemoryState *s = opaque;
+    uint8_t value = val;
+    if (addr == 0) {
+        s->flash_unlocked = s->key_stage == 0xb6 && value == 0x49;
+        s->key_stage = value == 0xb6 ? value : 0;
+        return;
+    }
+    s->key_stage = 0;
+    switch (addr) {
+    case 1:
+        if ((s->flash_io[7] & 0x80) && s->flash_io[8] < 2) {
+            unsigned at = s->flash_io[8] * 256 + s->flash_io[9];
+            /* NOR programming can only change ones into zeros. */
+            s->info[at] &= value;
+        } else {
+            unsigned at = s->flash_io[7] * 2048 +
+                          s->flash_io[8] * 256 + s->flash_io[9];
+            if (!(s->flash_io[7] & 0x80)) {
+                flash_program(s, at, value);
+            } else {
+                s->flash_io[6] |= 8;
+            }
+        }
+        flash_increment(s);
+        break;
+    case 2:
+        s->flash_upper = value & 0xfc;
+        update_mapping(s);
+        break;
+    case 3:
+        s->flash_ctl = value & 0xe8;
+        update_mapping(s);
+        break;
+    case 4:
+    case 5:
+        if (s->flash_unlocked) {
+            s->flash_io[addr] = value;
+        }
+        s->flash_unlocked = false;
+        break;
+    case 6:
+        s->flash_io[6] = (s->flash_io[6] & 0x2f) | (value & 0xc0);
+        break;
+    case 7:
+    case 9:
+        s->flash_io[addr] = value;
+        break;
+    case 8:
+        s->flash_io[8] = value & 7;
+        break;
+    case 10:
+        s->flash_io[10] = value & 4;
+        if (value & 3) {
+            uint8_t *data = memory_region_get_ram_ptr(&s->flash);
+            bool info = s->flash_io[7] & 0x80;
+            unsigned at = (s->flash_io[7] & 0x7f) * 2048;
+
+            if (value & 1) {
+                if (s->flash_io[5]) {
+                    s->flash_io[6] |= 1;
+                } else {
+                    memset(data, 0xff, 256 * KiB);
+                    memory_region_flush_rom_device(&s->flash, 0, 256 * KiB);
+                    if (info) {
+                        memset(s->info, 0xff, sizeof(s->info));
+                    }
+                    s->flash_io[6] |= 0x20;
+                }
+            } else if (info) {
+                memset(s->info, 0xff, sizeof(s->info));
+                s->flash_io[6] |= 0x20;
+            } else if (flash_protected(s, at)) {
+                s->flash_io[6] |= 2;
+            } else {
+                memset(data + at, 0xff, 2048);
+                memory_region_flush_rom_device(&s->flash, at, 2048);
+                s->flash_io[6] |= 0x20;
+            }
+        }
+        break;
+    }
+    flash_irq_update(s);
+}
+static uint64_t bus_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return EZ80F91_MEMORY(opaque)->bmc[addr];
+}
+static void bus_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    EZ80F91_MEMORY(opaque)->bmc[addr] = val & 0xef;
+}
+#define PORT_OPS(readfn, writefn) { \
+    .read = readfn, .write = writefn, .endianness = DEVICE_LITTLE_ENDIAN, \
+    .valid = { .min_access_size = 1, .max_access_size = 1 }, \
+    .impl = { .min_access_size = 1, .max_access_size = 1 }, \
+}
+static const MemoryRegionOps cs_ops = PORT_OPS(cs_read, cs_write);
+static const MemoryRegionOps ram_ops = PORT_OPS(ram_read, ram_write);
+static const MemoryRegionOps flash_ops = PORT_OPS(flash_read, flash_write);
+static const MemoryRegionOps bus_ops = PORT_OPS(bus_read, bus_write);
+
+static void memory_reset(Object *obj, ResetType type)
+{
+    EZ80F91MemoryState *s = EZ80F91_MEMORY(obj);
+    kit_accumulate(s);
+    memset(s->pb, 0, sizeof(s->pb));
+    s->pb[1] = 0xff;
+    s->pb_pending = 0;
+    button_irq_update(s);
+    s->kit_latch[0] = s->kit_latch[2] = 0;
+    s->kit_latch[1] = 0xff;
+    kit_clear_energy(s);
+    s->kit_static_ns = s->kit_last_ns;
+    s->kit_mask = 0;
+    memset(s->cs, 0, sizeof(s->cs));
+    memset(s->bmc, 2, sizeof(s->bmc));
+    s->cs[0][1] = 0xff;
+    s->cs[0][2] = 0xe8;
+    s->ram_ctl = 0xc0;
+    s->ram_upper = 0xff;
+    memset(s->flash_io, 0, sizeof(s->flash_io));
+    s->flash_io[5] = 0xff;
+    s->key_stage = 0;
+    s->flash_unlocked = false;
+    flash_irq_update(s);
+    s->flash_upper = 0;
+    s->flash_ctl = 0x88;
+    if (s->ram_boot) {
+        /* Explicit debugger-style setup, not the silicon reset state. */
+        s->cs[0][0] = 0x10;
+        s->cs[0][1] = 0x1f;
+        /* Debugger RAM boot must not overlay executing SRAM via CS0. */
+        s->cs[0][2] = 0;
+        s->cs[1][1] = 7;
+        s->cs[1][2] = 0x28;
+        s->cs[2][0] = 0x80;
+        s->cs[2][1] = 0xbf;
+        s->cs[2][2] = 0x28;
+        s->bmc[0] = s->bmc[1] = s->bmc[3] = 0;
+        s->bmc[2] = 0x81;
+        s->flash_ctl = 0x60;
+    }
+    update_mapping(s);
+}
+static uint64_t empty_cs_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return 0; /* Match the target's unassigned external bus value. */
+}
+static void empty_cs_write(void *opaque, hwaddr addr, uint64_t val,
+                           unsigned size)
+{
+}
+static const MemoryRegionOps empty_cs_ops = {
+    .read = empty_cs_read,
+    .write = empty_cs_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 1 },
+};
+/* IEEE CRC32, stored as a four-byte little-endian trailer. */
+static uint32_t flash_crc32(const uint8_t *data, size_t size)
+{
+    uint32_t crc = UINT32_MAX;
+    for (size_t i = 0; i < size; i++) {
+        crc = crc32_table[(crc ^ data[i]) & 255] ^ (crc >> 8);
+    }
+    return crc ^ UINT32_MAX;
+}
+
+static bool flash_write_image(const char *path, MemoryRegion *mr, GError **error)
+{
+    size_t size = memory_region_size(mr);
+    g_autofree uint8_t *image = g_malloc(size + 4);
+    memcpy(image, memory_region_get_ram_ptr(mr), size);
+    stl_le_p(image + size, flash_crc32(image, size));
+    return g_file_set_contents(path, (const char *)image, size + 4, error);
+}
+
+/* Raw flash images live in the invocation's working directory. */
+static bool flash_load(EZ80F91MemoryState *s, unsigned slot,
+                       MemoryRegion *mr, unsigned base, Error **errp)
+{
+    g_autofree char *contents = NULL;
+    g_autoptr(GError) error = NULL;
+    gsize length = 0;
+    size_t size = memory_region_size(mr);
+    uint8_t *data = memory_region_get_ram_ptr(mr);
+
+    for (unsigned i = 0; i < 5; i++) {
+        if (i != slot && s->persistent[i] && (i ? s->flash_base[i - 1] : 0) == base) {
+            error_setg(errp, "Flash filename base %X is used twice", base);
+            return false;
+        }
+    }
+    s->flash_file[slot] = g_strdup_printf("ez80f91_%X.%u", base,
+                                         qemu_get_ez80_debug_port());
+    memset(data, 0xff, size);
+    if (g_file_get_contents(s->flash_file[slot], &contents, &length, &error)) {
+        if (length == size + 4) {
+            uint32_t stored = ldl_le_p(contents + size);
+            uint32_t actual = flash_crc32((const uint8_t *)contents, size);
+            if (stored != actual) {
+                error_setg(errp, "%s CRC32 mismatch: stored %08X, calculated %08X",
+                           s->flash_file[slot], stored, actual);
+                return false;
+            }
+            length = size;
+        } else if (length > size) {
+            error_setg(errp, "%s exceeds flash size %zu",
+                       s->flash_file[slot], size);
+            return false;
+        }
+        memcpy(data, contents, length);
+    } else if (!g_error_matches(error, G_FILE_ERROR, G_FILE_ERROR_NOENT)) {
+        error_setg(errp, "Cannot load %s: %s", s->flash_file[slot],
+                   error->message);
+        return false;
+    }
+    s->persistent[slot] = mr;
+    return true;
+}
+
+/* Only explicit CS control writes bind an external image, never reset. */
+static void external_flash_activate(EZ80F91MemoryState *s, unsigned cs)
+{
+    unsigned slot = cs + 1;
+    unsigned base = s->cs[cs][0] << 16;
+    MemoryRegion *mr = s->external_flash[cs];
+    g_autoptr(GError) error = NULL;
+
+    if (!mr || (s->persistent[slot] && s->flash_base[cs] == base)) {
+        return;
+    }
+    if (s->persistent[slot]) {
+        if (!flash_write_image(s->flash_file[slot], mr, &error)) {
+            error_report("Cannot save %s: %s", s->flash_file[slot],
+                         error->message);
+            exit(EXIT_FAILURE);
+        }
+        s->persistent[slot] = NULL;
+    }
+    g_clear_pointer(&s->flash_file[slot], g_free);
+    flash_load(s, slot, mr, base, &error_fatal);
+    s->flash_base[cs] = base;
+}
+
+static void flash_save(Notifier *notifier, void *opaque)
+{
+    EZ80F91MemoryState *s = container_of(notifier, EZ80F91MemoryState,
+                                        flash_exit);
+
+    if (s->cs3_file) {
+        g_autoptr(GError) error = NULL;
+        if (!g_file_set_contents(s->cs3_file,
+                memory_region_get_ram_ptr(&s->bank[3]),
+                s->cs3_file_size, &error)) {
+            error_report("Cannot save %s: %s", s->cs3_file, error->message);
+        }
+    }
+
+    for (unsigned slot = 0; slot < 5; slot++) {
+        MemoryRegion *mr = s->persistent[slot];
+        g_autoptr(GError) error = NULL;
+
+        if (mr && !flash_write_image(s->flash_file[slot], mr, &error)) {
+            error_report("Cannot save %s: %s", s->flash_file[slot],
+                         error->message);
+        }
+    }
+}
+
+static void memory_realize(DeviceState *dev, Error **errp)
+{
+    EZ80F91MemoryState *s = EZ80F91_MEMORY(dev);
+    if (s->ram_boot && !s->evb) {
+        error_setg(errp, "RAM boot requires the FreeRTOS development board");
+        return;
+    }
+    if (!flash_load(s, 0, &s->flash, 0, errp)) {
+        return;
+    }
+    for (unsigned cs = 0; cs < 4; cs++) {
+        g_autofree char *name = g_strdup_printf("ez80f91.cs%u", cs);
+        MemoryRegion *source;
+
+        if (!s->cs_kind[cs]) {
+            s->cs_kind[cs] = g_strdup(cs ? "ram" : "flash");
+        }
+        if (!strcmp(s->cs_kind[cs], "none")) {
+            /* An unpopulated higher-priority CS still blocks lower CS lines. */
+            memory_region_init_io(&s->bank[cs], OBJECT(s), &empty_cs_ops, s,
+                                  name, 16 * MiB);
+            source = &s->bank[cs];
+        } else if (!strcmp(s->cs_kind[cs], "ram")) {
+            /* Stable backing keeps data across window moves and resizes. */
+            if (!memory_region_init_ram(&s->bank[cs], OBJECT(s), name,
+                                        16 * MiB, errp)) {
+                return;
+            }
+            source = &s->bank[cs];
+            if (cs == 3 && s->cs3_file) {
+                g_autofree char *contents = NULL;
+                g_autoptr(GError) error = NULL;
+                gsize length;
+                if (!g_file_get_contents(s->cs3_file, &contents, &length, &error)) {
+                    error_setg(errp, "Cannot load %s: %s", s->cs3_file,
+                               error->message);
+                    return;
+                }
+                if (!length || length > 16 * MiB) {
+                    error_setg(errp, "CS3 file must contain 1..16777216 bytes");
+                    return;
+                }
+                memcpy(memory_region_get_ram_ptr(source), contents, length);
+                s->cs3_file_size = length;
+            }
+        } else if (!strcmp(s->cs_kind[cs], "flash")) {
+            DeviceState *flash = qdev_new(TYPE_PFLASH_CFI02);
+
+            object_property_add_child(OBJECT(s), name, OBJECT(flash));
+            /* AMD AM29LV008BB: 1 MiB, bottom boot sectors, byte-wide bus. */
+            qdev_prop_set_string(flash, "name", name);
+            qdev_prop_set_uint8(flash, "width", 1);
+            qdev_prop_set_uint8(flash, "mappings", 16);
+            qdev_prop_set_uint16(flash, "id0", 0x01);
+            qdev_prop_set_uint16(flash, "id1", 0x37);
+            qdev_prop_set_uint16(flash, "unlock-addr0", 0x555);
+            qdev_prop_set_uint16(flash, "unlock-addr1", 0x2aa);
+            qdev_prop_set_uint32(flash, "num-blocks0", 1);
+            qdev_prop_set_uint32(flash, "sector-length0", 16 * KiB);
+            qdev_prop_set_uint32(flash, "num-blocks1", 2);
+            qdev_prop_set_uint32(flash, "sector-length1", 8 * KiB);
+            qdev_prop_set_uint32(flash, "num-blocks2", 1);
+            qdev_prop_set_uint32(flash, "sector-length2", 32 * KiB);
+            qdev_prop_set_uint32(flash, "num-blocks3", 15);
+            qdev_prop_set_uint32(flash, "sector-length3", 64 * KiB);
+            if (!sysbus_realize_and_unref(SYS_BUS_DEVICE(flash), errp)) {
+                return;
+            }
+            s->external_flash[cs] =
+                pflash_cfi02_get_memory(PFLASH_CFI02(flash));
+            memset(memory_region_get_ram_ptr(s->external_flash[cs]), 0xff, MiB);
+            source = sysbus_mmio_get_region(SYS_BUS_DEVICE(flash), 0);
+        } else {
+            error_setg(errp, "cs%u must be ram, flash or none", cs);
+            return;
+        }
+        memory_region_init_alias(&s->window[cs], OBJECT(s), name,
+                                 source, 0, 16 * MiB);
+        memory_region_set_enabled(&s->window[cs], false);
+        /* On-chip RAM/Flash win; among external devices CS0 wins over CS1. */
+        memory_region_add_subregion_overlap(get_system_memory(), 0,
+                                            &s->window[cs], 4 - cs);
+    }
+
+    if (s->cs3_file && strcmp(s->cs_kind[3], "ram")) {
+        error_setg(errp, "cs3-file requires cs3=ram");
+        return;
+    }
+    s->flash_exit.notify = flash_save;
+    qemu_add_exit_notifier(&s->flash_exit);
+    if (s->kit_led_file) {
+        s->kit_timer = timer_new_ms(QEMU_CLOCK_REALTIME, kit_publish, s);
+        kit_publish(s);
+    }
+}
+static void memory_init(Object *obj)
+{
+    EZ80F91MemoryState *s = EZ80F91_MEMORY(obj);
+    MemoryRegion *mem = get_system_memory(), *io = get_system_io();
+    memory_region_init_io(&s->kit_ports, obj, &kit_ops, s, "kit.led-gpio", 3);
+    memory_region_set_enabled(&s->kit_ports, false);
+    memory_region_add_subregion_overlap(mem, 0x800000, &s->kit_ports, 5);
+    memset(s->info, 0xff, sizeof(s->info));
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->flash_irq);
+    for (unsigned i = 0; i < 3; i++) {
+        sysbus_init_irq(SYS_BUS_DEVICE(s), &s->button_irq[i]);
+    }
+    object_property_add(obj, "kit-buttons", "uint8", buttons_get, buttons_set,
+                        NULL, NULL);
+    memory_region_init_io(&s->pb_ports, obj, &pb_ops, s, "f91.port-b", 4);
+    memory_region_add_subregion(io, 0x9a, &s->pb_ports);
+    memory_region_init_io(&s->pb_ack_port, obj, &pb_ack_ops, s, "f91.pb-alt0", 1);
+    memory_region_add_subregion(io, 0xa7, &s->pb_ack_port);
+    memory_region_init_rom_device(&s->flash, obj, &flash_array_ops, s,
+                                  "ez80f91.flash", 256 * KiB, &error_abort);
+    memset(memory_region_get_ram_ptr(&s->flash), 0xff, 256 * KiB);
+    memory_region_init_ram(&s->ram, obj, "ez80f91.ram", 8 * KiB, &error_abort);
+    memory_region_init_ram(&s->eram, obj, "ez80f91.emac-ram", 8 * KiB,
+                           &error_abort);
+    memory_region_add_subregion_overlap(mem, 0, &s->flash, 10);
+    memory_region_add_subregion_overlap(mem, 0xffe000, &s->ram, 20);
+    memory_region_add_subregion_overlap(mem, 0xffc000, &s->eram, 20);
+    memory_region_init_io(&s->cs_ports, obj, &cs_ops, s, "f91.cs", 12);
+    memory_region_add_subregion(io, 0xa8, &s->cs_ports);
+    memory_region_init_io(&s->ram_ports, obj, &ram_ops, s, "f91.ram-ctl", 2);
+    memory_region_add_subregion(io, 0xb4, &s->ram_ports);
+    memory_region_init_io(&s->flash_ports, obj, &flash_ops, s,
+                          "f91.flash-ctl", 11);
+    memory_region_add_subregion(io, 0xf5, &s->flash_ports);
+    memory_region_init_io(&s->bus_ports, obj, &bus_ops, s, "f91.bus-mode", 4);
+    memory_region_add_subregion(io, 0xf0, &s->bus_ports);
+}
+static const Property memory_properties[] = {
+    DEFINE_PROP_STRING("cs0", EZ80F91MemoryState, cs_kind[0]),
+    DEFINE_PROP_STRING("cs1", EZ80F91MemoryState, cs_kind[1]),
+    DEFINE_PROP_STRING("cs2", EZ80F91MemoryState, cs_kind[2]),
+    DEFINE_PROP_STRING("cs3", EZ80F91MemoryState, cs_kind[3]),
+    DEFINE_PROP_STRING("cs3-file", EZ80F91MemoryState, cs3_file),
+    DEFINE_PROP_BOOL("evb", EZ80F91MemoryState, evb, false),
+    DEFINE_PROP_BOOL("ram-boot", EZ80F91MemoryState, ram_boot, false),
+    DEFINE_PROP_STRING("kit-led-state", EZ80F91MemoryState, kit_led_file),
+};
+static void memory_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = memory_realize;
+    device_class_set_props(dc, memory_properties);
+    RESETTABLE_CLASS(oc)->phases.hold = memory_reset;
+    dc->user_creatable = false;
+}
+static const TypeInfo memory_type = {
+    .name = TYPE_EZ80F91_MEMORY,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(EZ80F91MemoryState),
+    .instance_init = memory_init,
+    .class_init = memory_class_init,
+};
+static void memory_register_types(void)
+{
+    type_register_static(&memory_type);
+}
+type_init(memory_register_types);
+
+MemoryRegion *ez80f91_emac_ram(DeviceState *dev)
+{
+    return &EZ80F91_MEMORY(dev)->eram;
+}
+uint32_t ez80f91_emac_base(DeviceState *dev)
+{
+    return (EZ80F91_MEMORY(dev)->ram_upper << 16) | 0xc000;
+}
+bool ez80f91_emac_enabled(DeviceState *dev)
+{
+    return EZ80F91_MEMORY(dev)->ram_ctl & 0x40;
+}
