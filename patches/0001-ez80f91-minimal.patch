diff --git a/pc-bios/ez80-zds/dtl.py b/pc-bios/ez80-zds/dtl.py
new file mode 100644
index 0000000..f9e05a0
--- /dev/null
+++ b/pc-bios/ez80-zds/dtl.py
@@ -0,0 +1,236 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Subset of the Smart Cable DTL language used by Zilog eZ80 algorithms.
+
+No Python eval: expressions and statements are parsed explicitly. Unknown syntax
+fails the request instead of acknowledging an operation that was not performed.
+"""
+
+import re
+
+
+class DTLError(ValueError):
+    pass
+
+
+TOKEN = re.compile(
+    r'\s+|"[0-9a-fA-F]*"|[RV][0-9A-Fa-f]{2}|[0-9A-Fa-f]+'
+    r'|\+\+|--|<<|>>|<=|>=|==|!=|&&|\|\||.'
+)
+OPS = {
+    "||": 1,
+    "&&": 2,
+    "|": 3,
+    "^": 4,
+    "&": 5,
+    "==": 6,
+    "!=": 6,
+    "<": 7,
+    ">": 7,
+    "<=": 7,
+    ">=": 7,
+    "<<": 8,
+    ">>": 8,
+    "+": 9,
+    "-": 9,
+    "*": 10,
+    "/": 10,
+    "%": 10,
+}
+
+
+class DTL:
+    def __init__(self, target):
+        self.target = target
+        self.variables = [0] * 256
+        self.buffer = bytearray()
+        self.steps = 0
+
+    def take(self, expected=None):
+        if self.pos >= len(self.tokens):
+            raise DTLError("unexpected end")
+        token = self.tokens[self.pos]
+        if expected is not None and token != expected:
+            raise DTLError(f"expected {expected}, got {token}")
+        self.pos += 1
+        return token
+
+    def peek(self):
+        return self.tokens[self.pos] if self.pos < len(self.tokens) else ""
+
+    def expr(self, minimum=0):
+        token = self.take()
+        if token in ("!", "~", "-", "+"):
+            a = self.expr(11)
+            value = {
+                "!": lambda: int(not a),
+                "~": lambda: ~a,
+                "-": lambda: -a,
+                "+": lambda: a,
+            }[token]()
+        elif token == "(":
+            value = self.expr()
+            self.take(")")
+        elif token == "[":
+            start = self.expr()
+            if self.peek() == ":":
+                self.take()
+                count = self.expr()
+                self.take("]")
+                value = bytes(self.buffer[start : start + count])
+            else:
+                self.take("]")
+                if not 0 <= start < len(self.buffer):
+                    raise DTLError(f"buffer index {start}")
+                value = self.buffer[start]
+        elif token == "@":
+            value = len(self.buffer)
+        elif re.fullmatch("V[0-9A-Fa-f]{2}", token):
+            index = int(token[1:], 16)
+            value = self.variables[index]
+            if self.peek() in ("++", "--"):
+                self.variables[index] += 1 if self.take() == "++" else -1
+        elif re.fullmatch("R[0-9A-Fa-f]{2}", token):
+            value = self.target.read(int(token[1:], 16))
+        elif token.startswith('"'):
+            value = bytes.fromhex(token[1:-1])
+        elif re.fullmatch("[0-9A-Fa-f]+", token):
+            value = int(token, 16)
+        else:
+            raise DTLError(f"invalid expression {token}")
+        while self.peek() in OPS and OPS[self.peek()] >= minimum:
+            op = self.take()
+            right = self.expr(OPS[op] + 1)
+            if isinstance(value, bytes) or isinstance(right, bytes):
+                raise DTLError("arithmetic on byte buffer")
+            operations = {
+                "+": lambda: value + right,
+                "-": lambda: value - right,
+                "*": lambda: value * right,
+                "/": lambda: value // right,
+                "%": lambda: value % right,
+                "<<": lambda: value << right,
+                ">>": lambda: value >> right,
+                "&": lambda: value & right,
+                "|": lambda: value | right,
+                "^": lambda: value ^ right,
+                "==": lambda: int(value == right),
+                "!=": lambda: int(value != right),
+                "<": lambda: int(value < right),
+                ">": lambda: int(value > right),
+                "<=": lambda: int(value <= right),
+                ">=": lambda: int(value >= right),
+                "&&": lambda: int(bool(value) and bool(right)),
+                "||": lambda: int(bool(value) or bool(right)),
+            }
+            value = operations[op]()
+        if minimum == 0 and self.peek() == "?":
+            self.take()
+            yes = self.expr()
+            self.take(":")
+            no = self.expr()
+            value = yes if value else no
+        return value
+
+    def block(self, end=None):
+        while self.pos < len(self.tokens) and self.peek() != end:
+            self.steps += 1
+            if self.steps > 100000:
+                raise DTLError("instruction limit")
+            token = self.take()
+            if token == ".":
+                self.buffer.clear()
+            elif token == "#":
+                # GET_EMUL_CONFIG: firmware major/minor, capability byte,
+                # then the transport buffer size in big-endian order. The
+                # DLL derives its block sizes from this advertised limit.
+                self.buffer.extend(self.target.configuration())
+            elif token == "$":
+                self.output.extend(self.buffer)
+            elif token == "_":
+                self.expr()  # Firmware delay; virtual target needs none.
+            elif token == "\\":
+                if self.expr():
+                    return True
+            elif token == "{":
+                count = None if self.peek() == ":" else self.expr()
+                self.take(":")
+                start = self.pos
+                depth = 1
+                finish = start
+                while finish < len(self.tokens) and depth:
+                    if self.tokens[finish] == "{":
+                        depth += 1
+                    if self.tokens[finish] == "}":
+                        depth -= 1
+                    finish += 1
+                if depth:
+                    raise DTLError("unclosed loop")
+                for _ in range(100000 if count is None else count):
+                    self.pos = start
+                    if self.block("}"):
+                        break
+                else:
+                    if count is None:
+                        raise DTLError("unbounded loop")
+                self.pos = finish
+            elif token == "[":
+                index = None if self.peek() == "]" else self.expr()
+                count = None
+                if self.peek() == ":":
+                    self.take()
+                    count = self.expr()
+                self.take("]")
+                self.take("=")
+                if count is not None:
+                    start = self.pos
+                    # The shipped memory-read algorithms repeat a bare R20.
+                    # Batch that stream while preserving all other expression
+                    # side effects through the normal interpreter path.
+                    if self.peek() == "R20" and hasattr(self.target, "read_block"):
+                        following = self.tokens[self.pos + 1] if self.pos + 1 < len(self.tokens) else ""
+                        if following not in OPS and following not in ("?", "++", "--"):
+                            self.take()
+                            raw = self.target.read_block(0x20, count)
+                            if index + count > len(self.buffer):
+                                self.buffer.extend(bytes(index + count - len(self.buffer)))
+                            self.buffer[index:index + count] = raw
+                            continue
+                    for offset in range(count):
+                        self.pos = start
+                        value = self.expr()
+                        position = index + offset
+                        if position >= len(self.buffer):
+                            self.buffer.extend(
+                                bytes(position - len(self.buffer) + 1)
+                            )
+                        self.buffer[position] = value & 255
+                    continue
+                value = self.expr()
+                raw = (
+                    value if isinstance(value, bytes) else bytes([value & 255])
+                )
+                if index is None:
+                    self.buffer.extend(raw)
+                else:
+                    if not 0 <= index < len(self.buffer):
+                        raise DTLError("buffer write out of range")
+                    self.buffer[index : index + len(raw)] = raw
+            elif re.fullmatch("[RV][0-9A-Fa-f]{2}", token):
+                self.take("=")
+                value = self.expr()
+                index = int(token[1:], 16)
+                if token[0] == "V":
+                    self.variables[index] = value
+                else:
+                    self.target.write(index, value)
+            else:
+                raise DTLError(f"unknown statement {token}")
+        return False
+
+    def execute(self, script):
+        self.tokens = [t for t in TOKEN.findall(script) if not t.isspace()]
+        self.pos = 0
+        self.steps = 0
+        self.output = bytearray()
+        self.block()
+        return bytes(self.output)
diff --git a/pc-bios/ez80-zds/ethernet.py b/pc-bios/ez80-zds/ethernet.py
new file mode 100644
index 0000000..d6fc35b
--- /dev/null
+++ b/pc-bios/ez80-zds/ethernet.py
@@ -0,0 +1,177 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Expose a local QEMU eZ80F91 as an Ethernet Smart Cable for ZDS II."""
+
+import argparse
+import logging
+import socket
+import re
+import select
+import threading
+from dtl import DTL
+from zdi import ZDI
+from rsp import RSP
+
+
+def receive(sock, size):
+    result = bytearray()
+    while len(result) < size:
+        chunk = sock.recv(size - len(result))
+        if not chunk:
+            raise EOFError
+        result.extend(chunk)
+    return bytes(result)
+
+
+def decode_script(raw):
+    # DLL inserts binary payloads after []=<hex byte count>:, including NULs.
+    result = bytearray()
+    position = 0
+    marker = re.compile(rb"\[\]=([0-9A-Fa-f]+):")
+    while match := marker.search(raw, position):
+        count = int(match[1], 16)
+        start = match.end()
+        end = start + count
+        if end > len(raw):
+            raise ValueError("truncated binary DTL buffer")
+        result.extend(raw[position : match.start()])
+        result.extend(b'[]="')
+        result.extend(raw[start:end].hex().encode())
+        result.extend(b'"')
+        position = end
+    result.extend(raw[position:])
+    return result.decode("ascii")
+
+
+def session(client, interpreter):
+    while True:
+        target = interpreter.target
+        if target.rsp.running:
+            ready, _, _ = select.select(
+                [client, target.rsp.socket], [], [], 0.05
+            )
+            if target.rsp.socket in ready:
+                target.rsp.poll()
+                if not target.rsp.running and target.cable.get(0xF0, 0) & 2:
+                    client.sendall(b"\x04\x00\x01\x00")
+            if client not in ready:
+                continue
+        header = receive(client, 3)
+        size = int.from_bytes(header[:2], "little")
+        if size < 4 or size > 65535 or header[2] != 0:
+            raise ValueError("invalid DTL frame")
+        raw = receive(client, size - 3)
+        try:
+            if not raw.endswith(b"\0"):
+                raise ValueError("missing terminator")
+            script = decode_script(raw[:-1])
+            logging.debug("DTL %s", script)
+            result = interpreter.execute(script)
+            payload = (
+                b"00"
+                + f"{len(result):04X}".encode()
+                + result.hex().upper().encode()
+                + b"\0"
+            )
+            logging.debug("result %s", payload)
+        except (ValueError, RuntimeError) as error:
+            logging.error("DTL failed: %s (%r)", error, raw)
+            payload = b"01\0"
+        client.sendall(
+            (len(payload) + 3).to_bytes(2, "little") + b"\0" + payload
+        )
+
+
+def scan_device(server, port, stop, name="QEMU-eZ80F91"):
+    """Nexus EthernetSCScan protocol: UDP scan -> 100,name,MAC,TCP-port."""
+    mac = f"02:5A:44:49:{port >> 8:02X}:{port & 255:02X}"
+    reply = f"100,{name},{mac},{port}".encode("ascii")
+    server.settimeout(0.25)
+    while not stop.is_set():
+        try:
+            packet, address = server.recvfrom(512)
+        except socket.timeout:
+            continue
+        if packet.rstrip(b"\0") == b"scan":
+            server.sendto(reply, address)
+            logging.info("Scan device: %s -> %s:%d", address, name, port)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--listen", help="Bind address; scan mode defaults to 0.0.0.0"
+    )
+    parser.add_argument("--port", type=int, default=4040)
+    parser.add_argument("--gdb-host", default="127.0.0.1")
+    parser.add_argument("--gdb-port", type=int, default=1234)
+    parser.add_argument("--gdb-socket", help="Private QEMU GDB Unix socket")
+    parser.add_argument(
+        "--scan-dev",
+        action="store_true",
+        help="Enable SDK-compatible discovery on UDP 3000",
+    )
+    parser.add_argument(
+        "--run",
+        action="store_true",
+        help="Resume QEMU after the debugger service is ready",
+    )
+    parser.add_argument("--name", default="QEMU-eZ80F91")
+    parser.add_argument("--verbose", action="store_true")
+    args = parser.parse_args()
+    args.listen = args.listen or ("0.0.0.0" if args.scan_dev else "127.0.0.1")
+    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO)
+    rsp = RSP(args.gdb_host, args.gdb_port, unix=args.gdb_socket)
+    stop = threading.Event()
+    discovery = None
+    scanner = None
+    try:
+        with socket.socket() as server:
+            server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            server.bind((args.listen, args.port))
+            server.listen(1)
+            if args.scan_dev:
+                discovery = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+                discovery.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+                discovery.bind((args.listen, 3000))
+                scanner = threading.Thread(
+                    target=scan_device,
+                    args=(discovery, args.port, stop, args.name),
+                    daemon=True,
+                )
+                scanner.start()
+            if args.run:
+                rsp.run()
+            logging.info(
+                "Smart Cable TCP %s:%d -> QEMU %s",
+                args.listen,
+                args.port,
+                args.gdb_socket or f"{args.gdb_host}:{args.gdb_port}",
+            )
+            while True:
+                client, address = server.accept()
+                logging.info("ZDS connected: %s", address)
+                with client:
+                    target = ZDI(rsp)
+                    try:
+                        session(client, DTL(target))
+                    except EOFError:
+                        pass
+                    except (ConnectionError, OSError, ValueError):
+                        logging.exception("connection failed")
+                rsp.stop()
+                target.sync_breakpoints(0)
+    finally:
+        stop.set()
+        if scanner:
+            scanner.join(timeout=1)
+        if discovery:
+            discovery.close()
+        rsp.socket.close()
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except KeyboardInterrupt:
+        pass
diff --git a/pc-bios/ez80-zds/rsp.py b/pc-bios/ez80-zds/rsp.py
new file mode 100644
index 0000000..054909b
--- /dev/null
+++ b/pc-bios/ez80-zds/rsp.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Small synchronous GDB remote client for the local QEMU debug endpoint."""
+
+import socket
+import select
+
+
+class RSP:
+    def __init__(self, host=None, port=None, unix=None):
+        if unix:
+            self.socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            self.socket.settimeout(10)
+            self.socket.connect(unix)
+        else:
+            self.socket = socket.create_connection((host, port), timeout=10)
+            self.socket.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+        self.running = False
+        self.command("?")
+
+    def packet(self):
+        while True:
+            marker = self.socket.recv(1)
+            if not marker:
+                raise ConnectionError("QEMU disconnected")
+            if marker == b"$":
+                break
+        data = bytearray()
+        while True:
+            c = self.socket.recv(1)
+            if not c:
+                raise ConnectionError("QEMU disconnected")
+            if c == b"#":
+                break
+            data.extend(c)
+        check = bytearray()
+        while len(check) < 2:
+            chunk = self.socket.recv(2 - len(check))
+            if not chunk:
+                raise ConnectionError("QEMU disconnected")
+            check.extend(chunk)
+        if int(check, 16) != sum(data) & 255:
+            raise ConnectionError("RSP checksum")
+        self.socket.sendall(b"+")
+        return data.decode("ascii")
+
+    def command(self, command):
+        raw = command.encode("ascii")
+        self.socket.sendall(
+            b"$" + raw + b"#" + f"{sum(raw) & 255:02x}".encode()
+        )
+        reply = self.packet()
+        # An out-of-band interrupt can precede a command reply when QMP
+        # resumed the CPU independently of this RSP connection.
+        while command not in ("?", "s") and reply.startswith(("T", "S")):
+            reply = self.packet()
+        return reply
+
+    def poll(self):
+        if self.running and select.select([self.socket], [], [], 0)[0]:
+            self.packet()
+            self.running = False
+
+    def stop(self, force=False):
+        self.poll()
+        if force and not self.running:
+            self.socket.sendall(b"\x03")
+            self.command("?")
+        elif self.running:
+            self.socket.sendall(b"\x03")
+            self.packet()
+            self.running = False
+
+    def registers(self):
+        self.stop()
+        raw = bytes.fromhex(self.command("g"))
+        if len(raw) != 96:
+            raise RuntimeError("QEMU needs the eZ80 GDB register patch")
+        return [
+            int.from_bytes(raw[i : i + 4], "little") for i in range(0, 96, 4)
+        ]
+
+    def set_registers(self, values):
+        self.stop()
+        if (
+            self.command(
+                "G" + b"".join(v.to_bytes(4, "little") for v in values).hex()
+            )
+            != "OK"
+        ):
+            raise RuntimeError("register write failed")
+
+    def memory(self, address, count):
+        self.stop()
+        reply = self.command(f"m{address:x},{count:x}")
+        if reply.startswith("E"):
+            raise RuntimeError(f"unmapped memory at {address:06x}: {reply}")
+        return bytes.fromhex(reply)
+
+    def write_memory(self, address, data):
+        self.stop()
+        # QEMU's GDB packet buffer is bounded; ZDS sends RAM test and loader
+        # buffers of several KiB. Keep the hex payload below that limit.
+        for offset in range(0, len(data), 1024):
+            chunk = data[offset:offset + 1024]
+            if self.command(f"M{address + offset:x},{len(chunk):x}:" + chunk.hex()) != "OK":
+                raise RuntimeError("memory write failed")
+
+    def step(self):
+        self.stop()
+        reply = self.command("s")
+        if not reply.startswith(("T", "S")):
+            raise RuntimeError(f"step: {reply}")
+
+    def run(self):
+        self.socket.sendall(b"$c#63")
+        if self.socket.recv(1) != b"+":
+            raise ConnectionError("QEMU rejected continue")
+        self.running = True
diff --git a/pc-bios/ez80-zds/zdi.py b/pc-bios/ez80-zds/zdi.py
new file mode 100644
index 0000000..492513a
--- /dev/null
+++ b/pc-bios/ez80-zds/zdi.py
@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""eZ80F91 ZDI registers backed by QEMU's stopped CPU and port space."""
+
+from dtl import DTLError
+
+
+class ZDI:
+    def __init__(self, rsp):
+        self.rsp = rsp
+        self.cable = {0xEC: 1, 0xEE: 1, 0xEF: 1}
+        self.wr = bytearray(256)
+        self.rd = bytearray(3)
+        self.break_control = 0x80
+        self.breakpoints = set()
+        self.prefetch = True
+
+    def configuration(self):
+        # The EthernetSC DLL receives at most 0x2100 bytes per frame.
+        # Advertise 0x2000 so its hex-encoded replies fit that buffer.
+        return bytes([1, 1, 0, 0x20, 0])
+
+    def read(self, address):
+        if address >= 0xEA:
+            return self.cable.get(address, 0)
+        if address in (0, 1, 2):
+            return (8, 0, 1)[address]
+        if address == 3:
+            # A running target can stop on one of the hardware breakpoints.
+            self.rsp.poll()
+            if self.rsp.running:
+                return 0
+            r = self.rsp.registers()
+            return 0x80 | (r[18] << 4) | (r[19] << 3) | (r[20] << 2)
+        if 0x10 <= address <= 0x12:
+            return self.rd[address - 0x10]
+        if address == 0x20:
+            r = self.rsp.registers()
+            pc = r[0]
+            value = 0 if self.prefetch else self.rsp.memory(pc, 1)[0]
+            self.prefetch = False
+            r[0] = (pc + 1) & 0xFFFFFF
+            self.rsp.set_registers(r)
+            return value
+        raise DTLError(f"unsupported ZDI read {address:02x}")
+
+    def read_block(self, address, count):
+        """Read the ZDI memory stream with its initial prefetch byte."""
+        if address != 0x20:
+            return bytes(self.read(address) for _ in range(count))
+        if not count:
+            return b""
+        r = self.rsp.registers()
+        pc = r[0]
+        result = bytearray()
+        if self.prefetch:
+            result.append(0)
+            pc = (pc + 1) & 0xFFFFFF
+            self.prefetch = False
+        while len(result) < count:
+            length = min(count - len(result), 1024, 0x1000000 - pc)
+            result.extend(self.rsp.memory(pc, length))
+            pc = (pc + length) & 0xFFFFFF
+        r[0] = pc
+        self.rsp.set_registers(r)
+        return bytes(result)
+
+    def write(self, address, value):
+        if address >= 0xEA:
+            self.cable[address] = (
+                int.from_bytes(value, "big")
+                if isinstance(value, bytes)
+                else value
+            )
+            return
+        if address == 0x30:
+            raw = value if isinstance(value, bytes) else bytes([value & 255])
+            r = self.rsp.registers()
+            self.rsp.write_memory(r[0], raw)
+            r[0] = (r[0] + len(raw)) & 0xFFFFFF
+            self.rsp.set_registers(r)
+            return
+        value &= 255
+        self.wr[address] = value
+        if address == 0x10:
+            self.break_control = value
+            if value & 0x80:
+                self.rsp.stop()
+                if value & 1:
+                    self.rsp.step()
+            else:
+                self.sync_breakpoints(value)
+                if not self.rsp.running:
+                    self.rsp.run()
+        elif address == 0x11 and value & 0x80:
+            self.rsp.stop(force=True)
+            reply = self.rsp.command("qRcmd," + b"system_reset".hex())
+            while reply.startswith("O") and reply != "OK":
+                reply = self.rsp.packet()
+        elif address == 0x16:
+            # The shipped GET_REGS_ALL Algo16 uses R16=16 to recover MBASE
+            # before restoring AF. This is a Nexus algorithm compatibility
+            # alias for Read AF, not an additional silicon ZDI command.
+            if value == 0x16:
+                value = 0
+            r = self.rsp.registers()
+            if value in (8, 9):
+                r[18] = int(value == 8)
+            elif value == 10:
+                for a, b in ((1, 6), (2, 7), (3, 8), (12, 14), (13, 15)):
+                    r[a], r[b] = r[b], r[a]
+            elif value & 0x7F <= 7:
+                which = value & 7
+                index = (None, 1, 2, 3, 4, 5, 9 if r[18] else 10, 0)[which]
+                if value & 0x80:
+                    v = int.from_bytes(self.wr[0x13:0x16], "little")
+                    if which == 0:
+                        r[12], r[13], r[17] = (
+                            v & 255,
+                            (v >> 8) & 255,
+                            (v >> 16) & 255,
+                        )
+                    else:
+                        r[index] = v
+                        if which == 7:
+                            self.prefetch = True
+                else:
+                    v = (
+                        r[12] | r[13] << 8 | r[17] << 16
+                        if which == 0
+                        else r[index]
+                    )
+                    if which == 7 and not self.prefetch:
+                        # ZDI reports the CPU's two-byte instruction prefetch
+                        # ahead of the memory stream. The shipped split-read
+                        # algorithms subtract three, then discard one dummy
+                        # byte after writing PC for the next block.
+                        v = (v + 2) & 0xFFFFFF
+                    self.rd[:] = v.to_bytes(3, "little")
+            else:
+                raise DTLError(f"ZDI RW control {value:02x}")
+            self.rsp.set_registers(r)
+        elif address == 0x25:
+            self.inject()
+        elif (
+            address <= 0x0F
+            or 0x13 <= address <= 0x15
+            or 0x21 <= address <= 0x24
+        ):
+            pass  # Write-only ZDI latch.
+        else:
+            raise DTLError(f"unsupported ZDI write {address:02x}")
+
+    def sync_breakpoints(self, control):
+        points = {
+            int.from_bytes(self.wr[i * 4 : i * 4 + 3], "little")
+            for i in range(4)
+            if control & (8 << i)
+        }
+        for address in self.breakpoints - points:
+            if self.rsp.command(f"z0,{address:x},1") != "OK":
+                raise DTLError("clear breakpoint")
+        for address in points - self.breakpoints:
+            if self.rsp.command(f"Z0,{address:x},1") != "OK":
+                raise DTLError("set breakpoint")
+        self.breakpoints = points
+
+    def inject(self):
+        r = self.rsp.registers()
+        op, second, third = self.wr[0x25], self.wr[0x24], self.wr[0x23]
+        if op == 0x3E:
+            r[12] = second
+        elif op == 0xF3:
+            r[20] = r[21] = 0
+        elif op == 0xFB:
+            r[20] = r[21] = 1
+        elif op == 3:
+            r[1] = (r[1] + 1) & (0xFFFFFF if r[18] else 0xFFFF)
+        elif op == 0xED:
+            if second in (0x38, 0x78):
+                port = third if second == 0x38 else r[1] & 0xFFFF
+                r[12] = self.rsp.memory(0x1000000 + port, 1)[0]
+            elif second in (0x39, 0x79):
+                port = third if second == 0x39 else r[1] & 0xFFFF
+                self.rsp.write_memory(0x1000000 + port, bytes([r[12]]))
+            elif second == 0x4F:
+                r[16] = r[12]
+            elif second == 0x5F:
+                r[12] = r[16]
+                r[13] = (
+                    (r[13] & 1)
+                    | (r[12] & 0x80)
+                    | (0x40 if not r[12] else 0)
+                    | (r[21] << 2)
+                )
+            elif second == 0xD7:
+                r[3] = r[11]
+                r[13] = (
+                    (r[13] & 1)
+                    | (0x80 if r[11] & 0x8000 else 0)
+                    | (0x40 if not r[11] else 0)
+                    | (r[21] << 2)
+                )
+            elif second == 0xC7:
+                r[11] = r[3] & 0xFFFF
+            elif second == 0x6D:
+                r[17] = r[12]
+            elif second == 0x6E:
+                r[12] = r[17]
+            elif second in (0x7D, 0x7E):
+                r[19] = int(second == 0x7D)
+            else:
+                raise DTLError(f"unsupported injected ED {second:02x}")
+        else:
+            raise DTLError(f"unsupported injected opcode {op:02x}")
+        self.rsp.set_registers(r)
