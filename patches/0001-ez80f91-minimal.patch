diff --git a/target/ez80/translate.c b/target/ez80/translate.c
new file mode 100644
--- /dev/null
+++ b/target/ez80/translate.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "exec/translation-block.h"
+#include "exec/translator.h"
+#include "decode.h"
+#include "tcg/tcg-op.h"
+#include "exec/helper-proto.h"
+#include "exec/helper-gen.h"
+#define HELPER_H "helper.h"
+#include "exec/helper-info.c.inc"
+#undef HELPER_H
+
+static TCGv_i32 cpu_pc;
+typedef struct DisasContext {
+    DisasContextBase base;
+    bool adl;
+    CPUEZ80State *env;
+} DisasContext;
+
+void ez80_translate_init(void)
+{
+    cpu_pc = tcg_global_mem_new_i32(tcg_env, offsetof(CPUEZ80State, pc), "pc");
+}
+static void ez80_init_context(DisasContextBase *db, CPUState *cs)
+{
+    DisasContext *ctx = container_of(db, DisasContext, base);
+    ctx->adl = db->tb->flags & 1;
+    ctx->env = cpu_env(cs);
+    db->max_insns = 1;
+}
+static void ez80_tb_start(DisasContextBase *db, CPUState *cs)
+{
+}
+static void ez80_insn_start(DisasContextBase *db, CPUState *cs)
+{
+    tcg_gen_insn_start(db->pc_next, 0, 0);
+}
+static uint8_t translate_read(void *opaque, uint32_t address)
+{
+    DisasContext *ctx = opaque;
+    return translator_ldub(ctx->env, &ctx->base, address);
+}
+static void ez80_insn(DisasContextBase *db, CPUState *cs)
+{
+    DisasContext *ctx = container_of(db, DisasContext, base);
+    uint32_t pc = db->pc_next;
+    tcg_gen_movi_i32(cpu_pc, pc);
+    /* Generic translator reads assume virtually contiguous pages. */
+    if ((ctx->adl ? pc : pc & 0xffff) >=
+        (ctx->adl ? 0xfffff8 : 0xfff8)) {
+        translator_io_start(db);
+        gen_helper_boundary(tcg_env);
+        db->pc_next = pc + 1;
+        return;
+    }
+    EZ80Decode insn = {
+        .read = translate_read, .opaque = ctx,
+        .cursor = pc, .adl = ctx->adl,
+    };
+    ez80_decode(&insn);
+    db->pc_next = insn.cursor;
+    if (!insn.valid) {
+        gen_helper_illegal(tcg_env, tcg_constant_i32(ez80_illegal_pc(&insn)),
+                           tcg_constant_i32(insn.mode));
+        db->is_jmp = DISAS_TOO_MANY;
+        return;
+    }
+    if (((insn.mode & EZ80_ED)
+         && ((insn.op & 0xc6) == 0x00 || (insn.op & 0xc6) == 0x40
+             || insn.op == 0x74 || ez80_block_io(insn.op)))
+        || (!(insn.mode & (EZ80_ED | EZ80_CB))
+            && (insn.op == 0xdb || insn.op == 0xd3))) {
+        translator_io_start(db);
+    }
+    gen_helper_execute(tcg_env, tcg_constant_i32(insn.op),
+                       tcg_constant_i32(insn.arg), tcg_constant_i32(insn.mode),
+                       tcg_constant_i32(insn.cursor));
+    if (ez80_halt(insn.op, insn.mode)) {
+        gen_helper_halt(tcg_env);
+        db->is_jmp = DISAS_NORETURN;
+    }
+}
+static void ez80_tb_stop(DisasContextBase *db, CPUState *cs)
+{
+    if (db->is_jmp != DISAS_NORETURN) {
+        tcg_gen_exit_tb(NULL, 0);
+    }
+}
+static const TranslatorOps ez80_ops = {
+    .init_disas_context = ez80_init_context,
+    .tb_start = ez80_tb_start,
+    .insn_start = ez80_insn_start,
+    .translate_insn = ez80_insn,
+    .tb_stop = ez80_tb_stop,
+};
+void ez80_translate_code(CPUState *cs, TranslationBlock *tb, int *max_insns,
+                         vaddr pc, void *host_pc)
+{
+    DisasContext ctx = {};
+    translator_loop(cs, tb, max_insns, pc, host_pc, &ez80_ops, &ctx.base,
+                    TCG_TYPE_VA);
+}
