+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef EZ80_CPU_QOM_H
+#define EZ80_CPU_QOM_H
+#include "hw/core/cpu.h"
+#define TYPE_EZ80_CPU "ez80-cpu"
