-        add 	hl,bc
-        ld 		bc,de        			; hi result in BC (TOS)
-        jr 		nc,mplus1
-        inc 	bc
+        ; Save the sign extension of the signed 24-bit addend.
+        push hl
+        ld hl,7fffffh
+        or a
+        sbc hl,bc
+        pop hl
+        push af
+        add hl,bc
+        ld bc,de
+        jr nc,mplus_carry_done
+        inc bc
+mplus_carry_done:
+        pop af
+        jr nc,mplus1
+        dec bc
 mplus1: pop 	de          			; restore saved IP
         push 	hl        	 			; push lo result
         next
