{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FreeRTOS: Build",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/firmware.py",
                "build",
                "--config",
                "${input:firmwareConfig}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "zilog",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) Z(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "FreeRTOS: Rebuild",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/firmware.py",
                "build",
                "--config",
                "${input:firmwareConfig}",
                "--rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "zilog",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) Z(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "group": "build"
        },
        {
            "label": "FreeRTOS: QEMU-Flash programmieren",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/flash_firmware.py",
                "--config",
                "${input:firmwareConfig}",
                "--build",
                "--stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "zilog",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) Z(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "FreeRTOS: Build, Flash und Kit starten",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/flash_firmware.py",
                "--config",
                "${input:firmwareConfig}",
                "--build",
                "--stop",
                "--run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "zilog",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) Z(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "FreeRTOS: QEMU stoppen",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/flash_firmware.py",
                "--stop-only"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "owner": "zilog",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning) Z(\\d+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "code": 5,
                        "message": 6
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "Configure Qt platform tools",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/platform-tools",
                "-G",
                "Ninja"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Qt platform tools",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/platform-tools"
            ],
            "dependsOn": "Configure Qt platform tools",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build eZ80 QEMU",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build/ez80",
                "-j8",
                "qemu-system-ez80"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "eZ80 QEMU mit Kit starten",
            "type": "process",
            "command": "qemuez80f91",
            "args": [
                "--kit",
                "--run",
                "--wd2797a",
                "0x1234",
                "--dev",
                "${workspaceFolder}/ez80f91_disks.4040"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "firmwareConfig",
            "type": "pickString",
            "description": "FreeRTOS-Konfiguration (beide starten aus Flash)",
            "options": [
                "Release",
                "Debug"
            ],
            "default": "Release"
        }
    ]
}
