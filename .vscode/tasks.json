{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Qt platform tools",
            "type": "process",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build/platform-tools", "-G", "Ninja"],
            "problemMatcher": []
        },
        {
            "label": "Build Qt platform tools",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/platform-tools"],
            "dependsOn": "Configure Qt platform tools",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build eZ80 QEMU",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/build/ez80",
                "-j8",
                "qemu-system-ez80"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "eZ80 QEMU mit Kit starten",
            "type": "process",
            "command": "qemuez80f91",
            "args": [
                "--kit",
                "--run",
                "--wd2797a",
                "0x1234",
                "--dev",
                "${workspaceFolder}/ez80f91_disks.4040"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
